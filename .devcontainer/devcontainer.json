{
  "name": "dev-vm",

  // Plain Ubuntu: the toolchain comes from Nix, not from the image.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // Single-user install. A container has no systemd, so the multi-user
    // daemon has nothing to run under.
    "ghcr.io/devcontainers/features/nix:1": {
      "multiUser": false,
      "extraNixConfig": "experimental-features = nix-command flakes\nsandbox = false"
    },

    // Explicit, though claude-code only declares `installsAfter` on it rather
    // than a hard dependency. Without it that feature falls back to installing
    // Node 18 from NodeSource itself — its own failure message recommends
    // adding this line. This way the version is the feature's LTS, not 18.
    "ghcr.io/devcontainers/features/node:1": {},

    // Not a `devcontainers/*` feature, so it was checked rather than assumed
    // (§8: devcontainers-extra, -contrib, -community and itsmechlark all
    // return no manifest on ghcr). This one resolves: anthropics/…/claude-code
    // answers 200 at both `1` and `1.0`, currently 1.0.5. It takes no options.
    //
    // It also pulls in the `anthropic.claude-code` editor extension by itself,
    // via its own customizations. That one is on Open VSX as well as the
    // Microsoft marketplace, so it installs under code-server too — checked,
    // because §8's marketplace split is exactly where this would have failed.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // The Nix store on a named volume, so recreating the container does not mean
  // re-downloading nixpkgs and the whole closure. Docker seeds an empty volume
  // from the image, so the feature's install survives the first mount; after
  // that the volume wins. Evaluating this flake is ~40s cold and ~10s warm.
  //
  // Delete the volume (`docker volume rm dev-vm-nix-store`) if you ever want a
  // genuinely clean store — an image rebuild alone will not replace it.
  //
  // Claude Code's state — credentials, settings, session history, memory —
  // otherwise lives in the container layer and dies with every `codespace
  // rebuild`, which means logging in again and losing anything remembered.
  //
  // A volume rather than a bind mount of /persist, for two reasons. It is what
  // works in a real Codespace (bind mounts are ignored there, volume mounts are
  // not), and Docker's data-root is already /persist/docker, so the volume is
  // on /persist anyway — §3's "everything precious lives in /persist" holds.
  // The cost is that it is not browsable from the VM the way /persist/git is;
  // it is under /persist/docker/volumes/dev-vm-claude/_data.
  //
  // Unlike /nix, this path does not exist in the image, so Docker creates the
  // mount point root-owned rather than seeding it — hence the chown in
  // postCreateCommand, without which Claude Code cannot write to its own
  // directory. /home/vscode is hardcoded because the image pins that user.
  //
  // ${devcontainerId} because Docker's volume namespace is flat and global to
  // the daemon: a fixed name here means any other repo that copies this file
  // silently shares one Claude state directory, two containers writing it at
  // once. The variable is unique per dev container on a host and stable across
  // rebuilds, so persistence survives while the collision cannot happen. The
  // cost is a separate login per codespace, which is also what a real
  // Codespace does.
  //
  // The store deliberately does NOT use it. Sharing one nixpkgs closure across
  // codespaces is the entire point of that mount — `codespace rm --volume`
  // reports it rather than quietly discarding it.
  "mounts": [
    "source=dev-vm-nix-store,target=/nix,type=volume",
    "source=claude-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  "customizations": {
    "vscode": {
      // Open VSX has nix-ide; the Microsoft marketplace is not reachable from
      // code-server. This particular extension happens to be published to both,
      // so it also resolves in a real Codespace — do not assume that of the
      // next Open VSX pick.
      "extensions": ["jnoortheen.nix-ide"],
      "settings": {
        "nix.enableLanguageServer": true,
        // Provided by postCreateCommand below. nix-ide ships no server of its
        // own, so without that install this setting names a binary that is not
        // there and the language server silently never starts.
        "nix.serverPath": "nil"
      }
    }
  },

  // `nil` is the language server the setting above points at. Installed here
  // rather than added to a devShell because nothing enters a devShell on its
  // own — the editor's terminals and the extension host would both miss it.
  //
  // Pinned to the same channel as flake.nix rather than the bare `nixpkgs#`
  // registry alias, which resolves to unstable (CLAUDE.md §10). It is the
  // channel, not flake.lock's exact revision, so this may differ by a few
  // commits from what the flake evaluates against — which costs an extra
  // nixpkgs fetch at create time and matters not at all for a language server.
  //
  // `add` not `install`: the latter is a deprecated alias as of nix 2.35. Both
  // are idempotent — a second run warns "already added" and exits 0.
  //
  // The chown is for the .claude volume above, and must come first: it is what
  // makes the directory writable at all. Harmless when already correct.
  //
  // The second chown is for Claude Code's auto-updater. Features install as
  // root, and the claude-code feature is a bare `npm install -g`, so under
  // root's umask its package lands root-owned 0755 inside a prefix the node
  // feature made vscode:nvm and group-writable for exactly this purpose. The
  // updater cannot replace its own package and reports "no write permission to
  // npm prefix", although the prefix itself is writable. The feature's fault,
  // not this VM's, so a real Codespace needs this too. `npm prefix -g` because
  // the path embeds the Node version, which moves with the node feature's LTS.
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) ~/.claude && sudo chown -R $(id -u):$(id -g) \"$(npm prefix -g)/lib/node_modules/@anthropic-ai\" && nix profile add nixpkgs/nixos-26.05#nil && nix --version && nil --version && echo 'Nix ready. Build here; apply with `rebuild` on the VM.'"
}
