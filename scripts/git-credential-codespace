#!/bin/sh
# git-credential-codespace — git's credential helper inside a codespace.
#
# With GITHUB_AUTH=app the launcher sets this as credential.https://github.com
# .helper in the container's system git config, and no SSH credential exists in
# the container at all. git asks it for a password; it asks the VM's token
# broker at /mnt/github/token.sock, which answers with a token scoped to this
# codespace's own repository (docs/GITHUB-APP.md). Asked on every operation,
# so an 8-hour token never goes stale under a long-running codespace.
#
# Only `get`, and only for https://github.com: anything else is not ours, and
# git moves on to its next helper.
#
# GH_TOKEN, when set, wins — the same override gh honours. The launcher never
# sets it, so it is only ever there because you exported one: a PAT for
# something beyond this codespace's repository, as you would in a real
# Codespace. `unset GH_TOKEN` and git is back on the scoped token.
#
# Plain sh plus curl, because it runs in whatever image the codespace uses.
# The VM copies it into the mounted directory.

[ "${1:-}" = get ] || exit 0

proto="" host=""
while IFS= read -r line; do
  [ -n "$line" ] || break
  case "$line" in
    protocol=*) proto=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done
[ "$proto" = https ] && [ "$host" = github.com ] || exit 0

if [ -n "${GH_TOKEN:-}" ]; then
  printf 'username=x-access-token\npassword=%s\n' "$GH_TOKEN"
  exit 0
fi

sock=/mnt/github/token.sock
if [ ! -S "$sock" ]; then
  echo "git-credential-codespace: no token broker at $sock" >&2
  exit 0
fi

out=$(curl -sS --unix-socket "$sock" -w '\n%{http_code}' http://vm/token 2>&1)
code=$(printf '%s\n' "$out" | tail -n 1)
body=$(printf '%s\n' "$out" | sed '$d')

if [ "$code" = 200 ] && [ -n "$body" ]; then
  printf 'username=x-access-token\npassword=%s\n' "$body"
  exit 0
fi

# Say why, then give git nothing: it fails with its own message after this
# one, rather than with an opaque "Authentication failed".
echo "git-credential-codespace: the VM gave no token (HTTP $code):" >&2
printf '%s\n' "$body" | sed 's/^/  /' >&2
exit 0
