# vm-control — answers one request from a codespace, then exits.
#
# Started by systemd once per connection on /run/vm-control/control.sock
# (modules/vm-control.nix), with the socket as stdin and stdout. The client is
# scripts/vm, which speaks to it with `curl --unix-socket`: curl is already a
# hard dependency of every codespace (the code-server install runs it), so a
# minimal HTTP framing costs nothing on the container side, where socat and nc
# are not guaranteed.
#
# The verbs are a fixed list, and nothing the client sends reaches a shell or
# a command line unvalidated. None of them changes the running system: applying
# stays `rebuild` on the VM. The reason is that a codespace with this socket can
# also write @FLAKE_DIR@, so one that could switch would be root on the VM.
#
# Built by modules/vm-control.nix with pkgs.writeShellApplication.

FLAKE_DIR=@FLAKE_DIR@
FLAKE_ATTR=@FLAKE_ATTR@
TOPLEVEL="$FLAKE_DIR#nixosConfigurations.$FLAKE_ATTR.config.system.build.toplevel"

# Units whose status and journal a codespace may read. An allowlist, because
# the journal is not harmless: editor-tls prints the client certificate's
# passphrase there once, and code-server-password's history still holds the
# password the editors used before they moved behind nginx.
allowed_unit() {
  case "$1" in
    code-server-password*|editor-tls*) return 1 ;;
    code-server|code-server.service|nginx|nginx.service) ;;
    codespace-gc|codespace-gc.service|codespace-gc.timer) ;;
    git-allowed-signers*|git-identity-template*) ;;
    # The credential services log repositories, permissions, expiries and
    # revocations — never a token, which is what makes them readable here.
    codespace-auth-clients*|codespace-token*|codespace-sign*) ;;
    docker|docker.service|docker.socket) ;;
    sshd|sshd.service|nix-daemon|nix-daemon.service|nix-gc*|nix-optimise*) ;;
    vm-control.socket|vm-control@*) ;;
    *) return 1 ;;
  esac
}

usage() {
  cat <<'USAGE'
vm — ask the VM about itself, from inside a codespace

  vm status               running and booted system, checkout, failed units
  vm unit <unit>          systemctl status
  vm journal <unit> [n]   the last n lines of its journal (default 50);
                          name@ for every instance of a template
  vm codespaces           codespace list --size
  vm volumes              docker volume ls
  vm df                   disk usage: filesystems, then docker's own view

  vm leftovers            anything still on the VM from removed features:
                          files on /persist, config keys, old containers

  vm build                build the checkout with the VM's store, and say
                          what would change against the running system
  vm check                nix flake check on the checkout

Nothing here applies a change. On the VM: rebuild
USAGE
}

cmd_status() {
  local running booted
  running=$(readlink -f /run/current-system)
  booted=$(readlink -f /run/booted-system)
  echo "host:     $(cat /proc/sys/kernel/hostname)  up $(cut -d. -f1 /proc/uptime | awk '{ printf "%dd %dh %dm", $1/86400, $1%86400/3600, $1%3600/60 }')"
  echo "nixos:    $(cat /run/current-system/nixos-version)"
  echo "running:  $running"
  if [ "$running" != "$booted" ]; then
    echo "booted:   $booted  (differs — a reboot would change the kernel or initrd)"
  fi
  echo "checkout: $FLAKE_DIR at $(git -C "$FLAKE_DIR" log -1 --format='%h %s')"
  local dirty
  dirty=$(git -C "$FLAKE_DIR" --no-optional-locks status --porcelain | wc -l)
  [ "$dirty" -gt 0 ] && echo "          $dirty uncommitted change(s)"
  echo
  local failed
  if ! failed=$(systemctl --failed --no-legend --plain | awk '{ print $1 }'); then
    echo "failed units: could not ask systemd"
  elif [ -n "$failed" ]; then
    echo "failed units:"
    awk '{ print "  " $0 }' <<<"$failed"
  else
    echo "failed units: none"
  fi
  echo
  echo "(vm build to compare the checkout against the running system)"
}

cmd_build() {
  local new running
  running=$(readlink -f /run/current-system)
  echo "==> building $TOPLEVEL"
  # The same flake reference `rebuild` uses, so "no changes" here means no
  # changes there. accept-flake-config off and the lock file left alone: the
  # checkout is writable from the codespace asking, and neither a nixConfig in
  # it nor this build should get to change anything on the VM.
  new=$(nix build --no-link --print-out-paths -L \
    --no-write-lock-file --option accept-flake-config false \
    "$TOPLEVEL") || return
  echo "==> built $new"
  if [ "$new" = "$running" ]; then
    echo "==> no changes: identical to the running system"
    return
  fi
  echo "==> differs from the running system:"
  nix store diff-closures "$running" "$new"
  echo
  echo "==> apply on the VM with: rebuild"
}

# What removed features left behind, checked rather than assumed: each item
# is something the repo no longer creates or reads, but a VM that ran the old
# version may still hold. Existence and names only — never a file's contents,
# never a config value, never a journal line. Each finding says how to clear
# it, on the VM; nothing here deletes. Exit 1 when anything is found.
#
# Add an item here whenever a feature is removed, and drop it once every VM
# that could have had it is clean.
cmd_leftovers() {
  local found=0
  hit() { found=1; printf 'found: %s\n       %s\n' "$1" "$2"; }

  # Launcher settings that are gone. Key names only: a value is printed by
  # nothing here.
  local conf=/persist/codespace/config keys
  if [ -r "$conf" ]; then
    keys=$(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?(GITHUB_AUTH|GIT_SSH_MODE|GIT_SIGNING)=.*/\2/p' "$conf" | sort -u | tr '\n' ' ')
    [ -n "$keys" ] && hit "$conf sets ${keys% } — no longer read (GITHUB_AUTH=legacy makes up refuse)" "delete those lines"
  fi

  # Containers whose mounts predate a change. Mounts are fixed at create, so
  # only a rebuild clears any of these. Scanned before the files, because a
  # file still bind-mounted must not be deleted yet: docker refuses to start a
  # container whose bind source is missing.
  local id name mounts why kh_users=0
  while read -r id name; do
    [ -n "$id" ] || continue
    mounts=" $(docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$id" 2>/dev/null) "
    why=""
    case "$mounts" in
      *" /mnt/git-ssh/agent.sock "*|*" /tmp/ssh-agent.sock "*) why="$why, an SSH agent forwarded (can push anywhere)" ;;
    esac
    case "$mounts" in
      *" /mnt/git-ssh "*) why="$why, the private key mounted (can push anywhere)" ;;
    esac
    case "$mounts" in
      *" /mnt/git-ssh/known_hosts "*) why="$why, a known_hosts mount (harmless: GitHub's public host keys)"; kh_users=$((kh_users + 1)) ;;
    esac
    case "$mounts" in
      *" /mnt/editor "*) ;;
      *) why="$why, no editor socket (pre-nginx)" ;;
    esac
    case "$mounts" in
      *" /mnt/github "*) ;;
      *) why="$why, no credential services (cannot push or sign)" ;;
    esac
    case "$mounts" in
      *" /mnt/code-server "*) ;;
      *) why="$why, its own code-server copy" ;;
    esac
    [ -n "$why" ] && hit "codespace ${name:-?} (${id:0:12}):${why#,}" "codespace rebuild ${name:-<name>}"
  done < <(docker ps -a --filter label=codespace --format '{{.ID}} {{.Label "codespace"}}' 2>/dev/null)

  # Secrets at old paths. Names only; `up` refuses a codespace whose secrets
  # are still at one. The per-codespace ones sit in state directories this
  # socket can read; the other two are hidden from it, so only their
  # existence, and whether the old shared one is still a file, shows.
  local s cs
  for s in /persist/codespace/*/secrets; do
    [ -e "$s" ] || continue
    cs=${s%/secrets}; cs=${cs##*/}
    hit "$s — secrets at an old path, readable through this socket" "mv $s /persist/codespace/secrets/$cs"
  done
  if [ -f /persist/codespace/secrets ]; then
    hit "/persist/codespace/secrets is the old shared secrets file — now a directory, with it as secrets/all" \
      "mv /persist/codespace/secrets /persist/codespace/secrets.all && install -d -m 0700 /persist/codespace/secrets && mv /persist/codespace/secrets.all /persist/codespace/secrets/all"
  fi
  if [ -e /persist/codespace-secrets ]; then
    hit "/persist/codespace-secrets — where per-codespace secrets lived briefly" \
      "mv /persist/codespace-secrets/* /persist/codespace/secrets/ (if any), then rmdir /persist/codespace-secrets"
  fi

  if [ -e /persist/secrets ]; then
    hit "/persist/secrets — a spare root-only directory from phase 1 that nothing ever used" \
      "sudo ls -A /persist/secrets; if that prints nothing: sudo rmdir /persist/secrets"
  fi

  # Files. -e and -L: a dangling symlink counts too.
  local kh_fix="rm /persist/git/known_hosts"
  [ "$kh_users" -gt 0 ] && kh_fix="not yet: $kh_users container(s) above still mount it, and would not start without it. Delete it once they are rebuilt"
  local f
  for f in \
    "/persist/git/known_hosts|github-known-hosts.service wrote it for SSH git in containers; nothing reads it|$kh_fix" \
    "/persist/code-server/pw|the hub editor's password from before nginx|rm /persist/code-server/pw" \
    "/persist/code-server/env|the same password, as PASSWORD= for the hub's old EnvironmentFile|rm /persist/code-server/env" \
    "/persist/codespace/cache|code-server tarballs from before the shared store|rm -rf /persist/codespace/cache"
  do
    local path=${f%%|*} rest=${f#*|}
    if [ -e "$path" ] || [ -L "$path" ]; then
      hit "$path — ${rest%%|*}" "${rest#*|}"
    fi
  done

  # The old editor password is in this unit's journal history. Only whether
  # any entry is left, and the newest one's date — never a line of it.
  local newest
  newest=$(journalctl --no-pager -q -u code-server-password.service -n 1 -o short-iso 2>/dev/null | awk 'NR == 1 { print $1 }')
  [ -n "$newest" ] && hit "the journal still holds code-server-password entries, newest $newest — the old editor password" \
    "ages out with the journal; or sudo journalctl --rotate && sudo journalctl --vacuum-time=<age> to drop older files"

  # Files made in codespaces before the launcher set umask 022: docker exec
  # gave every process 0000, so the bind-mounted checkouts got world-writable
  # files and directories — including the flake root rebuilds from. A count
  # per tree, not a listing. Symlinks are always 0777 and do not count.
  local tree n
  for tree in /persist/dev-vm /persist/repos /persist/refs; do
    [ -d "$tree" ] || continue
    n=$(find "$tree" -xdev ! -type l -perm -o+w 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && hit "$tree — $n world-writable file(s) or directories, from codespaces' old umask 0000" \
      "chmod -R go-w $tree"
  done

  # Then everything else: whatever is on /persist that the repo neither
  # creates nor knows about. The lists below are what is *in use*; anything
  # outside them and not already named above is reported by name, for you to
  # look at — it may be yours. Only the directories whose layout this repo
  # defines are opened. The rest hold your work or another tool's (repos,
  # refs, home, docker, dev-vm, dotfiles), or are hidden from this socket
  # (ssh, tls, github-app, codespace/secrets).
  local unknown
  unknown=$(
    unlisted /persist \
      "codespace code-server dev-vm docker dotfiles git github-app home lost+found marker refs repos ssh tls" \
      "secrets codespace-secrets"
    unlisted /persist/git \
      "id_ed25519 id_ed25519.pub identity allowed_signers" \
      "known_hosts"
    unlisted /persist/code-server \
      "user-data extensions" \
      "pw env"
    unlisted /persist/codespace \
      "config secrets code-server .removed .code-server-staging .code-server.lock" \
      "cache" \
      codespaces
  )
  if [ -n "$unknown" ]; then
    hit "on /persist but not used by anything in this repo:" \
      "look before deleting — it may be yours. If it is a feature's leftover, add it to cmd_leftovers"
    printf '%s\n' "$unknown" | sed 's/^/         /'
  fi

  if [ "$found" = 0 ]; then
    echo "no leftovers: nothing from removed features, and nothing unknown, on the VM"
  fi
  return "$found"
}

# Prints each entry of $1 that is neither in use ($2) nor a leftover already
# reported by name above ($3). With a fourth argument, a directory holding a
# `port` file also counts as in use: that is what makes a codespace's state
# directory, and one without it is not one.
unlisted() {
  local dir=$1 known=" $2 " legacy=" $3 " codespaces=${4:-} e base
  [ -d "$dir" ] || return 0
  for e in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    base=${e##*/}
    case "$known$legacy" in *" $base "*) continue ;; esac
    if [ -n "$codespaces" ] && [ -d "$e" ] && [ ! -L "$e" ]; then
      [ -f "$e/port" ] && continue
      echo "$e/  (no port file: not a codespace's state)"
      continue
    fi
    if [ -d "$e" ] && [ ! -L "$e" ]; then echo "$e/"; else echo "$e"; fi
  done
}

cmd_check() {
  echo "==> nix flake check $FLAKE_DIR"
  nix flake check -L --no-write-lock-file --option accept-flake-config false "$FLAKE_DIR"
}

dispatch() {
  local verb="${1:-help}"
  none() { [ "$1" -eq 0 ] || { echo "vm: '$verb' takes no arguments"; return 2; }; }
  [ $# -gt 0 ] && shift
  case "$verb" in
    help) usage ;;
    status) none $# && cmd_status ;;
    unit)
      [ $# -eq 1 ] || { echo "usage: vm unit <unit>"; return 2; }
      allowed_unit "$1" || { echo "vm: '$1' is not on the list of readable units"; return 2; }
      # Exit 3 is "inactive", not a failure of the question.
      systemctl status --no-pager "$1" || [ $? -eq 3 ]
      ;;
    journal)
      [ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: vm journal <unit> [lines]"; return 2; }
      allowed_unit "$1" || { echo "vm: '$1' is not on the list of readable units"; return 2; }
      local n="${2:-50}" u="$1"
      case "$n" in ''|*[!0-9]*) echo "vm: lines must be a number"; return 2 ;; esac
      # A template's name, `codespace-token@`, means every instance: the
      # broker and signer are a fresh instance per request. Globbed here
      # because the client allows no `*` on the way in.
      case "$u" in *@) u="$u*" ;; esac
      journalctl --no-pager -u "$u" -n "$n"
      ;;
    # The VM's own launcher, the one you run there, rather than a copy built
    # into this script.
    codespaces) none $# && /run/current-system/sw/bin/codespace list --size ;;
    volumes) none $# && docker volume ls ;;
    df) none $# && { df -h / /persist /nix; echo; docker system df; } ;;
    leftovers) none $# && cmd_leftovers ;;
    build) none $# && cmd_build ;;
    check) none $# && cmd_check ;;
    *) echo "vm: unknown command '$verb'"; echo; usage; return 2 ;;
  esac
}

# ---- the request ----------------------------------------------------------
# One request line, then headers to a blank line. Timeouts so a client that
# connects and says nothing does not hold an instance open.
IFS= read -r -t 10 line || exit 0
line=${line%$'\r'}
while IFS= read -r -t 10 header; do
  [ -z "${header%$'\r'}" ] && break
done

read -r method target _ <<<"$line"

printf 'HTTP/1.0 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n'

# Always 200: the command's own exit status travels in a trailer line the
# client strips, because a status line has to be sent before the command runs.
finish() { printf '@@vm-exit %d\n' "$1"; exit 0; }

if [ "$method" != GET ]; then
  echo "vm: only GET"
  finish 2
fi
# Path segments are the arguments. Anything outside this set is refused here,
# before it can be a flag, a glob or a path.
target=${target#/}
case "$target" in
  *[!A-Za-z0-9@._/-]*|-*|*/-*|*..*) echo "vm: refusing '$target'"; finish 2 ;;
esac
IFS=/ read -r -a argv <<<"$target"

# awk ends the output with a newline if the command did not, so the trailer
# always starts a line of its own. fflush keeps it streaming: a build's log
# should arrive as it happens, not at the end.
set +e
dispatch "${argv[@]}" 2>&1 | awk '{ print; fflush() }'
rc=${PIPESTATUS[0]}
set -e
finish "$rc"
