# codespace — bring dev containers up and down, Codespaces style.
#
#   codespace up <url|path|name>   create/start a dev container and its editor
#   codespace new <name>           the same, on an empty workspace — no repo
#   codespace rebuild <name>       recreate the container, keeping the port
#   codespace shell <name>         a terminal inside it, in a tmux on the VM
#   codespace down <name>          stop it (the CLI has no `down` of its own)
#   codespace rm <name> [opts]     delete it; --repo drops the checkout, --volume its volumes
#   codespace list [--size]        what exists, on which port; --size: disk used by each
#   codespace logs <name>          editor log, for when the URL does not answer
#   codespace gc [--dry-run]       drop containers idle past RETENTION_DAYS
#
# No shebang: this is built by modules/codespace.nix with
# pkgs.writeShellApplication, which supplies one and runs shellcheck.

PORT_MIN=8001
PORT_MAX=8010
REPOS=/persist/repos
REFS=/persist/refs
# Mounted at /workspaces/$REFS_NAME, which makes it a reserved codespace name:
# a codespace called the same thing would land on the same path.
REFS_NAME=refs
STATE=/persist/codespace
# Where `rm` without --repo notes which checkout a codespace used, so a later
# `rm <name> --repo` deletes that checkout rather than guessing one from the
# name. Dot-named so the `$STATE/*/` loops never mistake it for a codespace.
REMOVED=$STATE/.removed
# code-server, unpacked once per version on the VM and mounted into every
# container — see ensure_code_server. Made immutable, because the mount cannot
# be read-only and a container must not be able to change another's editor.
CS_STORE=/persist/codespace/code-server
CS_STAGING=/persist/codespace/.code-server-staging
CS_LOCK=/persist/codespace/.code-server.lock
CONTAINER_CS=/mnt/code-server
# Credential services on the VM (modules/codespace-auth.nix): commit signing
# now, scoped GitHub tokens later. One directory for every codespace.
AUTH_DIR=/run/codespace-auth
CONTAINER_AUTH=/mnt/github
# Where a codespace's own snapshot of the dotfiles appears, when
# DOTFILES_REPOSITORY is a repository on the VM. See snapshot_dotfiles.
CONTAINER_DOTFILES=/mnt/dotfiles
# The VM control socket's directory (modules/vm-control.nix), and where it
# appears in a container. Plumbing, so under /mnt beside /mnt/git-ssh.
VM_CONTROL_DIR=/run/vm-control
CONTAINER_VM=/mnt/vm
# This VM's own flake checkout: its codespace gets the control socket by default.
FLAKE_DIR=@FLAKE_DIR@
# The default devcontainer.json for `--config template` (templates/ in the flake).
TEMPLATE=@TEMPLATE@
# Set from `--config` by the dispatcher at the bottom; read by choose_config.
CONFIG_CHOICE=""
# One directory per editor port, holding that editor's unix socket — nginx
# (modules/editor-proxy.nix) picks it by the port a request came in on, after
# checking the client certificate. Mounted into the container at
# CONTAINER_EDITOR. The directory rather than the socket, so a restarted editor's
# new socket is the one nginx sees.
EDITORS_DIR=/run/editors
CONTAINER_EDITOR=/mnt/editor
# The client certificate's dev-readable copy, left by editor-tls until imported.
TLS_EXPORT=$HOME/tls
# Real Codespaces deletes a codespace after 30 days of inactivity. Same default
# here, overridable from $STATE/config; 0 disables the sweep entirely. Only the
# *container* goes — see cmd_gc.
RETENTION_DAYS_DEFAULT=30

die() { echo "codespace: $*" >&2; exit 1; }
# Progress goes to stderr so that functions which echo a result can be used in
# a command substitution without their chatter landing in the result.
note() { echo "==> $*" >&2; }

usage() {
  cat >&2 <<'USAGE'
usage:
  codespace up <url|path|name>   create/start a dev container and its editor
  codespace new <name>           the same, on an empty workspace — no repo
  codespace rebuild <name|path>  recreate it from scratch, keeping the port
      up, new and rebuild take --config repo|template|plain|auto|<path>:
      which devcontainer.json to use. Sticks to the codespace once given
  codespace shell <name>         a terminal inside it, in a tmux on the VM
  codespace down <name>          stop it, keeping the container
  codespace rm <name> [opts]     delete it; --repo drops the checkout, --volume its volumes
  codespace list [--size]        what exists, on which port; --size: disk used by each
  codespace logs <name>          editor log, for when the URL does not answer
  codespace gc [--dry-run]       drop containers idle past RETENTION_DAYS
USAGE
  exit "${1:-1}"
}

# Container-safe name: docker labels and systemd unit instances both dislike
# most punctuation.
slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's![^a-z0-9._-]!-!g; s!^-*!!; s!-*$!!'; }

# Accepts a git URL, an absolute path, or the name of something already in
# /persist/repos. Echoes "<name> <workspace-folder>".
# Refused rather than allowed to shadow: a codespace called $REFS_NAME mounts
# its own workspace over /workspaces/$REFS_NAME, and every reference repo
# silently disappears from that container. Checked against the *resolved* name,
# because a URL like github.com/someone/refs also lands on it.
reject_reserved() {
  [ "$1" = "$REFS_NAME" ] || return 0
  die "'$REFS_NAME' is reserved — /workspaces/$REFS_NAME is the shared reference mount.
  Use another name: git clone <url> $REPOS/${REFS_NAME}-something && codespace up ${REFS_NAME}-something
  Reference checkouts themselves go in $REFS, no codespace needed."
}

resolve_workspace() {
  local target="$1" name dir

  # A bare `codespace up refs` never resolves to anything, so catch it here for
  # the useful message rather than letting it fall through to "no such repo".
  case "$target" in
    *://*|*@*:*|*/*) ;;
    *) reject_reserved "$(slugify "$target")" ;;
  esac

  # A codespace that already exists is addressable by name alone, so that
  # `up`/`rebuild` take the same argument as `down`/`logs` once it is created.
  name=$(slugify "$target")
  if [ -f "$STATE/$name/workspace" ]; then
    dir=$(cat "$STATE/$name/workspace")
    if [ -d "$dir" ]; then
      reject_reserved "$name"
      echo "$name $dir"; return
    fi
  fi

  if [ -d "$target" ]; then
    dir=$(realpath "$target")
    name=$(slugify "$(basename "$dir")")
    reject_reserved "$name"
    echo "$name $dir"; return
  fi

  if [ -d "$REPOS/$target" ]; then
    name=$(slugify "$target")
    reject_reserved "$name"
    echo "$name $REPOS/$target"; return
  fi

  case "$target" in
    *://*|*@*:*|github.com/*|gitlab.com/*) ;;
    *) die "no such repo '$target' — give a git URL, a path, or a name under $REPOS" ;;
  esac

  local url="$target"
  case "$url" in
    github.com/*|gitlab.com/*) url="https://$url" ;;
  esac

  name=$(slugify "$(basename "${url%.git}")")
  # Before the clone, so a reserved name costs nothing.
  reject_reserved "$name"
  dir="$REPOS/$name"
  if [ ! -d "$dir" ]; then
    note "cloning $url -> $dir"
    git clone "$url" "$dir" >&2 || die "clone failed"
  fi
  echo "$name $dir"
}

port_in_use() {
  local port="$1" other
  for other in "$STATE"/*/port; do
    [ -e "$other" ] || continue
    [ "$(dirname "$other")" = "$STATE/$2" ] && continue
    [ "$(cat "$other")" = "$port" ] && return 0
  done
  return 1
}

# Sticky: a codespace keeps its port, so bookmarks survive a down/up.
allocate_port() {
  local name="$1" port
  if [ -f "$STATE/$name/port" ]; then
    cat "$STATE/$name/port"; return
  fi
  for port in $(seq "$PORT_MIN" "$PORT_MAX"); do
    if ! port_in_use "$port" "$name"; then
      echo "$port"; return
    fi
  done
  die "all ports $PORT_MIN-$PORT_MAX are taken; 'codespace list' then 'codespace down' one"
}

# Whether codespace $1, on workspace $2, gets the VM control socket.
# VM_CONTROL in the config is a space-separated list of codespace names. Unset,
# it means only the codespace on this VM's own flake checkout — the one place
# where asking the VM is the work. Set and empty, nobody. Matched by checkout
# rather than by the name `dev-vm`, which any repo of that name would share.
vm_control_for() {
  if [ -z "${VM_CONTROL+set}" ]; then
    [ "$2" = "$FLAKE_DIR" ]
    return
  fi
  local -a names
  read -r -a names <<<"$VM_CONTROL"
  local n
  for n in "${names[@]}"; do
    [ "$n" = "$1" ] && return 0
  done
  return 1
}

# Which devcontainer.json a codespace uses. Echoes the path to pass as
# --override-config, or nothing for the repo's own config. Progress on stderr.
#
#   repo      the repo's .devcontainer/devcontainer.json or .devcontainer.json
#   template  $TEMPLATE, this flake's default — Claude Code, gh, node
#   plain     just DEFAULT_IMAGE, nothing else
#   <path>    any devcontainer.json, e.g. /persist/refs/devcontainer.json
#   auto      forget an earlier choice
#
# --config overrides even a repo's own config: --override-config replaces it
# wholesale. An explicit choice is recorded and sticks to the codespace, and
# rewrites the generated file every time it is given, so `--config template`
# also picks up a newer template. With no choice on record:
# the repo's own config if it has one, else a generated file already there
# (a codespace from before choices existed keeps what it had), else the template.
#
# Generated files live in the codespace's state directory, never the checkout:
# nothing is added to a repo you may not own, and the copy is yours to edit —
# add features, change the image, then `codespace rebuild`.
choose_config() {
  local name=$1 ws=$2 choice=$CONFIG_CHOICE explicit=1 repo_cfg="" src=""
  local override="$STATE/$1/devcontainer.json" record="$STATE/$1/config_source"

  if [ -f "$ws/.devcontainer/devcontainer.json" ]; then repo_cfg="$ws/.devcontainer/devcontainer.json"
  elif [ -f "$ws/.devcontainer.json" ]; then repo_cfg="$ws/.devcontainer.json"
  fi

  if [ "$choice" = auto ]; then
    rm -f "$record"
    choice=""
  fi
  if [ -z "$choice" ]; then
    explicit=0
    choice=$(cat "$record" 2>/dev/null || true)
  fi
  if [ -z "$choice" ]; then
    if [ -n "$repo_cfg" ]; then return 0; fi
    if [ -f "$override" ]; then echo "$override"; return 0; fi
    choice=template
  fi

  case "$choice" in
    repo)
      [ -n "$repo_cfg" ] || die "--config repo, but $ws has no devcontainer.json — try --config template or plain"
      [ "$explicit" = 1 ] && echo repo > "$record"
      note "using the repo's own $repo_cfg"
      return 0
      ;;
    template|plain|*/*|*.json) ;;
    *) die "--config takes repo, template, plain, auto, or a path to a devcontainer.json (got '$choice')" ;;
  esac

  # Rewritten when chosen explicitly; otherwise only made if missing, so edits
  # to the generated file survive every plain `up` and `rebuild`.
  if [ "$explicit" = 1 ] || [ ! -f "$override" ]; then
    # A path is resolved only here, when it is copied: the copy is what `up`
    # uses after that, so moving the source must not stop the codespace.
    case "$choice" in
      template|plain) ;;
      *) src=$(realpath -e "$choice" 2>/dev/null) || die "--config $choice: no such file"
         choice=$src ;;
    esac
    local new
    new=$(mktemp)
    case "$choice" in
      template) sed "s|@CODESPACE_NAME@|$name|" "$TEMPLATE" > "$new" ;;
      plain)    printf '{\n  "name": "%s",\n  "image": "%s"\n}\n' \
                  "$name" "${DEFAULT_IMAGE:-mcr.microsoft.com/devcontainers/base:ubuntu26.04}" > "$new" ;;
      *)        cp "$choice" "$new" ;;
    esac
    if [ -f "$override" ] && ! cmp -s "$new" "$override"; then
      mv "$override" "$override.bak"
      note "kept the previous $override as $override.bak"
    fi
    mv "$new" "$override"
    note "devcontainer.json from $choice: $override"
  fi
  [ "$explicit" = 1 ] && echo "$choice" > "$record"
  [ -n "$repo_cfg" ] && note "ignoring the repo's own $repo_cfg for this codespace (--config repo to use it)"
  echo "$override"
}

# The newest code-server already unpacked, or a failure if there is none.
newest_code_server() {
  local d v="" 
  for d in "$CS_STORE"/*/; do
    [ -x "$d/bin/code-server" ] || continue
    v=$(printf '%s\n%s\n' "$v" "$(basename "$d")" | sort -V | tail -1)
  done
  [ -n "$v" ] && echo "$v"
}

# Makes sure code-server $1 ("latest" or a version) is unpacked in $CS_STORE,
# and echoes the version. Progress on stderr.
#
# Once per version on the VM, rather than once per container: each container
# used to unpack its own 676 MB copy — most of its container layer, and 4.5 s
# of every create — from a tarball cache mounted read-write into all of them.
# A container has passwordless sudo, and the installer reused a cached tarball
# without checking it, so one compromised codespace could plant an editor that
# every later codespace would run.
#
# The store is mounted into containers, and the CLI's --mount cannot be
# read-only. So it is made immutable instead (chattr +i): changing that needs
# CAP_LINUX_IMMUTABLE, which Docker does not grant, so even root in a container
# cannot modify, delete or rename these files (tested: chattr is refused in a
# codespace). The store directory itself is immutable too, so a container
# cannot plant a version that has not been unpacked yet. A privileged
# container — docker-in-docker — could lift it, but is root on the VM anyway.
ensure_code_server() {
  local want=$1 v arch url
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64) arch=arm64 ;;
    *) die "no code-server release for $(uname -m)" ;;
  esac

  if [ "$want" = latest ]; then
    v=$(curl -fsSL --max-time 10 https://api.github.com/repos/coder/code-server/releases/latest 2>/dev/null \
        | jq -r '.tag_name // empty' 2>/dev/null || true)
    v=${v#v}
    if [ -z "$v" ]; then
      # Offline, or GitHub's unauthenticated rate limit: a create still works
      # with what is already here.
      v=$(newest_code_server) || die "could not ask GitHub for the latest code-server, and none is unpacked yet"
      note "could not reach GitHub for the latest code-server — using $v, already unpacked"
    fi
  else
    v=$want
  fi

  if [ ! -x "$CS_STORE/$v/bin/code-server" ]; then
    url="https://github.com/coder/code-server/releases/download/v$v/code-server-$v-linux-$arch.tar.gz"
    # A lock, so two creates at once cannot both unpack, and a temporary
    # directory on the same filesystem, so the version appears by one rename,
    # never half-written.
    (
      flock 9
      [ -x "$CS_STORE/$v/bin/code-server" ] && exit 0
      # Whatever happens below, the store ends immutable and the staging area
      # gone: a failure between lifting and restoring +i must not leave every
      # codespace's editor writable.
      trap 'sudo chattr +i "$CS_STORE"; sudo rm -rf "$CS_STAGING"' EXIT
      # Every step checked by hand: this subshell sits on the left of `||`,
      # where bash switches set -e off, so a failure would otherwise run on.
      note "fetching code-server $v — once, for every codespace"
      local src="$CS_STAGING/code-server-$v-linux-$arch"
      sudo rm -rf "$CS_STAGING" || exit 1
      mkdir -p "$CS_STAGING" || exit 1
      curl -fsSL "$url" | tar -xz -C "$CS_STAGING" || exit 1
      [ -x "$src/bin/code-server" ] || exit 1
      sudo chown -R root:root "$src" || exit 1
      sudo chattr -i "$CS_STORE" || exit 1
      sudo mv "$src" "$CS_STORE/$v" || exit 1
      # Not `chattr -R`: it fails on every symlink ("Operation not supported
      # while reading flags") and exits non-zero — node_modules/.bin is full of
      # them. A symlink cannot carry the bit, and needs none: it lives in a
      # directory that has it, so it cannot be replaced or removed.
      sudo find "$CS_STORE/$v" ! -type l -exec chattr +i {} + || exit 1
    ) 9>"$CS_LOCK" || die "could not fetch code-server $v from $url"
    # Checked, not assumed: an editor shared by every codespace must not be
    # left writable, or missing, by a failure above.
    [ -x "$CS_STORE/$v/bin/code-server" ] \
      || die "code-server $v is not in $CS_STORE after unpacking"
    lsattr -d "$CS_STORE/$v" 2>/dev/null | cut -d' ' -f1 | grep -q i \
      || die "$CS_STORE/$v is not immutable — refusing to share it"
  fi
  echo "$v"
}

# Clones the committed HEAD of the VM's dotfiles repository $2 into codespace
# $1's own state directory, as a bare repo, and echoes its path.
#
# A snapshot per codespace rather than the repository itself mounted into every
# container: the CLI cannot mount read-only, and the dotfiles' install.sh runs
# on every create — so a shared, writable copy would let one compromised
# codespace plant a script that every later one runs. Pointing
# DOTFILES_REPOSITORY into /workspaces/refs would do exactly that. A container
# can change its own snapshot, which nothing else ever reads.
#
# On /persist, beside the codespace's other state, not /run: docker will not
# start a container whose bind-mount source is missing, and this one must
# outlive a reboot. Made by rename, so a failed clone leaves the old one.
snapshot_dotfiles() {
  local name=$1 src=$2 snap="$STATE/$1/dotfiles.git"
  rm -rf "$snap.new"
  # file:// so --depth applies; a plain path makes git ignore it for a local
  # clone. Committed HEAD only: an uncommitted edit is not in the snapshot.
  git clone --quiet --bare --depth 1 "file://$src" "$snap.new" >&2 \
    || die "could not snapshot the dotfiles from $src"
  rm -rf "$snap"
  mv "$snap.new" "$snap"
  echo "$snap"
}

container_of() { docker ps -q --filter "label=codespace=$1" | head -1; }
container_any() { docker ps -aq --filter "label=codespace=$1" | head -1; }

load_config() {
  if [ -r "$STATE/config" ]; then
    # shellcheck source=/dev/null
    . "$STATE/config"
  fi
}

# "I used this" — the clock the retention sweep runs on. Recorded explicitly
# rather than inferred, because the obvious sources are both wrong: docker's
# .Created is when the container was built, and .State.FinishedAt is bumped by
# the VM shutting down, so a machine rebooted weekly would age nothing, ever.
touch_used() { mkdir -p "$STATE/$1" && : > "$STATE/$1/last_used"; }

# Falls back for codespaces that predate the marker: the last stop is a decent
# guess, and the state directory's own mtime is the floor. Never returns empty,
# so arithmetic on it cannot blow up under `set -u`.
last_used_epoch() {
  local name="$1" cid ts
  if [ -f "$STATE/$name/last_used" ]; then
    stat -c %Y "$STATE/$name/last_used"
    return
  fi
  cid=$(container_any "$name")
  if [ -n "$cid" ]; then
    ts=$(docker inspect -f '{{.State.FinishedAt}}' "$cid" 2>/dev/null || true)
    # Docker reports a zero time for a container that has never been stopped.
    case "$ts" in
      "" | 0001-01-01*) ;;
      *) date -d "$ts" +%s 2>/dev/null && return ;;
    esac
  fi
  stat -c %Y "$STATE/$name" 2>/dev/null || echo 0
}

idle_days() {
  local used now
  used=$(last_used_epoch "$1")
  now=$(date +%s)
  echo $(( (now - used) / 86400 ))
}

# Asks the editor itself, over its socket — never a process listing (§8).
editor_answers() {
  curl -fsS -o /dev/null --max-time 3 --unix-socket "$EDITORS_DIR/$1/editor.sock" \
    http://localhost/healthz 2>/dev/null
}

cmd_up() {
  [ $# -ge 1 ] || usage
  local name ws port cid remote_user remote_ws up_json resolved recreate="${2:-}"
  # Not inlined into the read: a die() inside a command substitution cannot
  # stop the caller, so the status has to be checked here.
  resolved=$(resolve_workspace "$1") || exit 1
  read -r name ws <<<"$resolved"
  [ -n "$name" ] || die "could not work out a name for '$1'"

  mkdir -p "$STATE/$name"
  port=$(allocate_port "$name")
  echo "$port" > "$STATE/$name/port"
  echo "$ws" > "$STATE/$name/workspace"
  # Alive again, so a note left by an earlier `rm` no longer describes it.
  rm -f "$REMOVED/$name"

  # Read before anything that might consult DEFAULT_IMAGE or DOTFILES_*.
  load_config

  local -a args=(
    up
    --workspace-folder "$ws"
    --id-label "codespace=$name"
  )
  if [ "$recreate" = recreate ]; then
    args+=(--remove-existing-container)
    warn_ephemeral "$name"
  fi

  local override
  override=$(choose_config "$name" "$ws") || exit 1
  if [ -n "$override" ]; then
    # --no-lockfile because the CLI places a feature lockfile beside the config
    # it *would* have read — the checkout's .devcontainer/, not this override —
    # and writes one by default whenever features are listed. With no
    # .devcontainer/ there, `up` dies with ENOENT on devcontainer-lock.json;
    # with one, it writes into a checkout this script promises not to touch.
    # Only here: a repo's own config keeps its lockfile, as in real Codespaces.
    args+=(--override-config "$override" --no-lockfile)
  fi

  # Git credentials inside the container (CLAUDE.md §8).
  #
  # A key file under /persist/git is tried first because its path is stable.
  # Agent forwarding leaks no key at all and would otherwise be the better
  # option, but $SSH_AUTH_SOCK points at a per-session directory: a container
  # created during one SSH session holds a bind mount to a socket that is dead
  # by the next login, and git then fails in a way that looks like a key
  # problem. So it is the fallback, not the default.
  #
  # Neither mount can be read-only: the CLI validates --mount strictly as
  # type/source/target/external and rejects `readonly`. /persist/git limits the
  # exposure to one key, rather than all of ~/.ssh or the host keys.
  # Glob into an array rather than `compgen -G`: nixpkgs builds bash without
  # programmable completion, so compgen does not exist and the test silently
  # takes the wrong branch. With nullglob unset, a pattern that matches nothing
  # survives literally and fails -e.
  local git_want="" ssh_cmd="" key=/persist/git/id_ed25519
  local have_key=0 key_locked=0 have_agent=0 agent_sock=/mnt/git-ssh/agent.sock

  [ -r "$key" ] && have_key=1
  # An encrypted key is still perfectly readable — it just cannot be *used*
  # without a passphrase, and a container has no terminal to ask at. Detect it
  # up front rather than letting ssh fail with a message that looks exactly
  # like an unregistered key.
  if [ "$have_key" = 1 ] && ! ssh-keygen -y -P "" -f "$key" >/dev/null 2>&1; then
    key_locked=1
  fi
  # `ssh-add -l` exits non-zero both when the agent is unreachable and when it
  # holds nothing, which are the same thing for our purposes.
  if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK:-}" ] && ssh-add -l >/dev/null 2>&1; then
    have_agent=1
  fi

  # GIT_SSH_MODE in /persist/codespace/config, one of:
  #
  #   auto     (default) agent if one is loaded, else an unencrypted key file
  #   agent    require the agent — fail rather than quietly exposing the key
  #   keyfile  require the key file
  #   none     no git credentials in containers at all
  #
  # `auto` is convenient but it downgrades silently: forget to `ssh-add` and it
  # mounts the private key instead, which is the opposite of what someone who
  # cares would want. `agent` makes that a hard error.
  local mode="${GIT_SSH_MODE:-auto}"
  case "$mode" in
    auto|agent|keyfile|none) ;;
    *) die "GIT_SSH_MODE must be auto, agent, keyfile or none (got '$mode')" ;;
  esac

  if [ "$mode" = agent ] || { [ "$mode" = auto ] && [ "$have_agent" = 1 ]; }; then
    if [ "$have_agent" != 1 ]; then
      die "GIT_SSH_MODE=agent, but no ssh-agent is holding a key. Run: ssh-add $key or ssh-auth"
    fi
    # A passphrase-protected key works without anything to prompt at, and the
    # crypto happens back on the VM.
    #
    # Under /mnt/git-ssh with the rest of git's credentials, not in /tmp: the
    # docker-in-docker entrypoint mounts a tmpfs over /tmp, which hid the socket
    # while `docker inspect` still listed it. Nothing claims /mnt.
    #
    # Only safe because this mode never mounts the /persist/git directory at
    # /mnt/git-ssh. If both ever coexist, docker creates this mount point
    # inside /persist/git on the VM.
    args+=(--mount "type=bind,source=$SSH_AUTH_SOCK,target=$agent_sock")
    # A container from before the move keeps /tmp/ssh-agent.sock: `up` reuses
    # it and ignores changed mounts. Match it, so --remote-env below names a
    # socket that exists. A rebuild removes it first, so gets the new path.
    local existing
    existing=$(container_any "$name")
    if [ "$recreate" != recreate ] && [ -n "$existing" ]; then
      case " $(docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$existing") " in
        *" /tmp/ssh-agent.sock "*) agent_sock=/tmp/ssh-agent.sock ;;
      esac
    fi
    git_want="agent"
    ssh_cmd="ssh"
  elif [ "$mode" = keyfile ] || { [ "$mode" = auto ] && [ "$have_key" = 1 ] && [ "$key_locked" = 0 ]; }; then
    if [ "$have_key" != 1 ]; then
      die "GIT_SSH_MODE=keyfile, but there is no key at $key"
    fi
    if [ "$key_locked" = 1 ]; then
      die "GIT_SSH_MODE=keyfile, but $key has a passphrase and nothing in a container can enter it. Use GIT_SSH_MODE=agent."
    fi
    git_want="keyfile"
    ssh_cmd="ssh -i /mnt/git-ssh/id_ed25519 -o IdentitiesOnly=yes"
  elif [ "$mode" = auto ] && [ "$key_locked" = 1 ]; then
    note "warning: $key has a passphrase and no ssh-agent is holding it."
    note "         Containers cannot prompt, so git inside this one will fail"
    note "         with 'Permission denied (publickey)'. Unlock it with:"
    note "             ssh-add $key"
    note "         then: codespace rebuild $name"
  fi

  # How much of /persist/git the container can see. Only the key-file mode has
  # any use for the private key, so only that mode gets the directory. Every
  # other mode gets the public half and known_hosts as individual file mounts —
  # the container needs the .pub to configure signing (the agent does the
  # crypto) and known_hosts to verify github, and neither is secret.
  #
  # Mounting the whole directory unconditionally, as this did until now, put the
  # private key inside every container even when nothing there could use it.
  local have_known_hosts=0
  if [ "$git_want" = keyfile ]; then
    args+=(--mount "type=bind,source=/persist/git,target=/mnt/git-ssh")
    [ -r /persist/git/known_hosts ] && have_known_hosts=1
  else
    # Guarded: docker silently creates a *directory* at a bind source that does
    # not exist, which would litter /persist/git and mount the wrong thing.
    [ -r "$key.pub" ] && \
      args+=(--mount "type=bind,source=$key.pub,target=/mnt/git-ssh/id_ed25519.pub")
    # Your name and email, so a container authors commits as the same person the
    # VM does. Not secret, and the same file either way.
    [ -r /persist/git/identity ] && \
      args+=(--mount "type=bind,source=/persist/git/identity,target=/mnt/git-ssh/identity")
    [ -r /persist/git/allowed_signers ] && \
      args+=(--mount "type=bind,source=/persist/git/allowed_signers,target=/mnt/git-ssh/allowed_signers")
    if [ -r /persist/git/known_hosts ]; then
      args+=(--mount "type=bind,source=/persist/git/known_hosts,target=/mnt/git-ssh/known_hosts")
      have_known_hosts=1
    fi
  fi

  # Create-time secrets: --secrets-file reaches the user commands that run
  # during `up`, including the dotfiles install — which is where a Codespaces
  # secret like $SSH_ANIMMOZ_KEY is expected. It takes a path, so nothing lands
  # on a command line where `ps` could read it. It does *not* persist into the
  # container, which is handled separately after `up`.
  local secrets_json secrets_file=""
  secrets_json=$(collect_secrets "$name")
  if [ -n "$secrets_json" ] && [ "$secrets_json" != "{}" ]; then
    secrets_file=$(mktemp)
    chmod 600 "$secrets_file"
    printf '%s' "$secrets_json" > "$secrets_file"
    args+=(--secrets-file "$secrets_file")
  fi

  # Reference checkouts, as a sibling of the project — the same shape as real
  # Codespaces, where /workspaces itself persists. Shared across containers on
  # purpose: clone a big reference repo once and every codespace can read it.
  # CONTAINER_REFS=0 in the launcher config turns it off.
  # The name guard in resolve_workspace makes the collision unreachable for new
  # codespaces; this keeps a pre-existing one from failing on a duplicate mount.
  if [ "${CONTAINER_REFS:-1}" != 0 ] && [ -d "$REFS" ] && [ "$name" != "$REFS_NAME" ]; then
    args+=(--mount "type=bind,source=$REFS,target=/workspaces/$REFS_NAME")
  fi

  # code-server, shared by every codespace and immutable — see
  # ensure_code_server. The directory must exist for the mount; versions are
  # unpacked into it after `up`, only when this container needs one.
  if [ ! -d "$CS_STORE" ]; then
    sudo install -d -o root -g root -m 0755 "$CS_STORE"
    sudo chattr +i "$CS_STORE"
  fi
  args+=(--mount "type=bind,source=$CS_STORE,target=$CONTAINER_CS")

  # The credential services' directory, in every new container whatever
  # GIT_SIGNING says now, so switching it later needs no rebuild. It grants
  # nothing a container does not already have: getting commits signed is what
  # the forwarded agent allows today, and more.
  if [ -d "$AUTH_DIR" ]; then
    args+=(--mount "type=bind,source=$AUTH_DIR,target=$CONTAINER_AUTH")
  fi

  # The VM control socket: read-only questions about the VM, and builds in its
  # store, for the codespaces allowed them (vm_control_for). The directory, not
  # the socket, so a restart of the socket unit does not strand the container
  # on a dead inode. Only takes effect on create, like every mount here.
  # The editor's socket directory. Made on every `up`, not just at create:
  # /run is a tmpfs, so after a VM reboot it is gone, and docker refuses to
  # start a container whose bind-mount source does not exist.
  #
  # As root, because it must end up setgid nginx — that is what gives the
  # socket nginx's group — and Linux clears the setgid bit on any chmod by a
  # user outside the directory's group, which dev is. A plain mkdir + chmod
  # here produced a socket nginx could not open. `install -d` sets all three
  # exactly, and on an existing directory repairs it in place rather than
  # replacing the inode a running container has mounted.
  sudo install -d -o "$(id -un)" -g nginx -m 2750 "$EDITORS_DIR/$port" \
    || die "could not create $EDITORS_DIR/$port — is modules/editor-proxy.nix applied?"
  args+=(--mount "type=bind,source=$EDITORS_DIR/$port,target=$CONTAINER_EDITOR")

  local want_vm=0
  if vm_control_for "$name" "$ws"; then
    want_vm=1
    if [ -S "$VM_CONTROL_DIR/control.sock" ]; then
      args+=(--mount "type=bind,source=$VM_CONTROL_DIR,target=$CONTAINER_VM")
    else
      note "warning: no VM control socket at $VM_CONTROL_DIR — is modules/vm-control.nix applied? Continuing without it."
    fi
  fi

  # The dotfiles clone runs *inside* the container, before anything this script
  # writes there exists — so a private dotfiles repo over https fails with
  # "could not read Username", and `up` still reports success, leaving the
  # dotfiles silently unapplied.
  #
  # --remote-env does reach that clone, so hand it the mounted key and rewrite
  # github https URLs to SSH. This makes DOTFILES_REPOSITORY work as either an
  # https or an ssh URL, private or not.
  if [ -n "$ssh_cmd" ]; then
    if [ "$have_known_hosts" = 1 ]; then
      ssh_cmd="$ssh_cmd -o UserKnownHostsFile=/mnt/git-ssh/known_hosts"
    fi
    ssh_cmd="$ssh_cmd -o StrictHostKeyChecking=accept-new"
    args+=(--remote-env "GIT_SSH_COMMAND=$ssh_cmd")
    [ "$git_want" = agent ] && args+=(--remote-env "SSH_AUTH_SOCK=$agent_sock")
    args+=(--remote-env "GIT_CONFIG_COUNT=1")
    args+=(--remote-env "GIT_CONFIG_KEY_0=url.git@github.com:.insteadOf")
    args+=(--remote-env "GIT_CONFIG_VALUE_0=https://github.com/")
  fi

  # DOTFILES_REPOSITORY is a URL for the CLI to clone inside the container —
  # or a git repository on the VM, such as /persist/dotfiles. That one is
  # snapshotted for this codespace (snapshot_dotfiles) and mounted at
  # $CONTAINER_DOTFILES; the CLI then clones from there, locally, in
  # milliseconds, with no network and no credential — a private repository
  # needs no token. Commit in the VM's repository and the next new codespace
  # has it; no push needed.
  if [ -n "${DOTFILES_REPOSITORY:-}" ]; then
    local dotfiles_repo=$DOTFILES_REPOSITORY snap
    case "$DOTFILES_REPOSITORY" in
      /*)
        if git -C "$DOTFILES_REPOSITORY" rev-parse --git-dir >/dev/null 2>&1; then
          snap="$STATE/$name/dotfiles.git"
          # Only when a container is about to be created: the dotfiles run
          # once per container, so a fresh snapshot for a plain `up` of an
          # existing one would be wasted. Unless it is missing, which would
          # stop that container starting at all.
          if [ "$recreate" = recreate ] || [ -z "$(container_any "$name")" ] || [ ! -d "$snap" ]; then
            snap=$(snapshot_dotfiles "$name" "$DOTFILES_REPOSITORY") || exit 1
            note "dotfiles: snapshot of $DOTFILES_REPOSITORY at $(git -C "$snap" log -1 --format='%h %s' 2>/dev/null)"
          fi
          args+=(--mount "type=bind,source=$snap,target=$CONTAINER_DOTFILES")
          dotfiles_repo=$CONTAINER_DOTFILES
        else
          # Not a repository here: assume a path meant for inside the
          # container, and pass it on as before.
          note "note: DOTFILES_REPOSITORY=$DOTFILES_REPOSITORY is not a git repository on the VM — passing it to the container as is"
        fi
        ;;
    esac
    args+=(--dotfiles-repository "$dotfiles_repo")
    [ -n "${DOTFILES_INSTALL_COMMAND:-}" ] && args+=(--dotfiles-install-command "$DOTFILES_INSTALL_COMMAND")
  fi

  note "starting dev container '$name' from $ws"
  # Progress and build logs go to stderr, so capturing stdout still shows them.
  up_json=$(devcontainer "${args[@]}") || { [ -n "$secrets_file" ] && rm -f "$secrets_file"; die "devcontainer up failed"; }
  [ -n "$secrets_file" ] && rm -f "$secrets_file"
  up_json=$(printf '%s\n' "$up_json" | tail -1)

  # Ask the CLI where things landed rather than guessing. remoteWorkspaceFolder
  # honours a workspaceFolder override in devcontainer.json, which assuming
  # /workspaces/<basename> would get wrong.
  cid=$(printf '%s' "$up_json" | jq -r '.containerId // empty')
  remote_user=$(printf '%s' "$up_json" | jq -r '.remoteUser // "root"')
  remote_ws=$(printf '%s' "$up_json" | jq -r '.remoteWorkspaceFolder // empty')
  [ -n "$cid" ] || die "devcontainer up reported no container: $up_json"
  [ -n "$remote_ws" ] || die "devcontainer up reported no workspace folder: $up_json"

  # Recorded so `codespace shell` can open a shell as the right user in the
  # right directory without paying for another `devcontainer up`.
  echo "$remote_user" > "$STATE/$name/remote_user"
  echo "$remote_ws" > "$STATE/$name/remote_workspace"
  touch_used "$name"

  # What the container actually has, not what the host happened to offer. `up`
  # reuses an existing container and silently ignores changed --mount flags, so
  # trusting git_want here would configure the editor for a mount that is not
  # there.
  local mounts git_ssh=""
  mounts=$(docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$cid")
  case " $mounts " in
    # Either path: containers created before the socket moved out of /tmp keep
    # it there until rebuilt. Everything after uses the one actually mounted.
    *" /mnt/git-ssh/agent.sock "*) git_ssh="agent"; agent_sock=/mnt/git-ssh/agent.sock ;;
    *" /tmp/ssh-agent.sock "*)     git_ssh="agent"; agent_sock=/tmp/ssh-agent.sock ;;
    # The whole directory, so the private key is there and usable.
    *" /mnt/git-ssh "*)        git_ssh="keyfile" ;;
    # Only the public half — no way to authenticate from in here.
    *" /mnt/git-ssh/id_ed25519.pub "*) git_ssh="locked" ;;
  esac
  if [ -n "$git_want" ] && [ "$git_want" != "$git_ssh" ] && [ "$git_ssh" != locked ]; then
    note "note: this container was created with git credentials '$git_ssh:-none';"
    note "      '$git_want' is available now — 'codespace rebuild $name' to switch"
  fi

  # The client lives in the mounted directory, so a VM rebuild updates it in
  # every container; the link puts it on PATH. Recreated on every `up`, since
  # /usr/local/bin is container layer.
  local have_vm=0
  case " $mounts " in
    *" $CONTAINER_VM "*)
      have_vm=1
      docker exec -u root "$cid" ln -sfn "$CONTAINER_VM/vm" /usr/local/bin/vm
      ;;
  esac
  if [ "$want_vm" = 1 ] && [ "$have_vm" = 0 ] && [ -S "$VM_CONTROL_DIR/control.sock" ]; then
    note "note: this container predates the VM control socket — 'codespace rebuild $name' to add it"
  fi

  # code-server comes from the VM, not from a feature: no third-party feature
  # for it resolves on ghcr, and this leaves the project's devcontainer.json
  # untouched, so it stays portable to real Codespaces. The release is a
  # standalone build with its own Node, so it runs on any glibc base image.
  #
  # CODE_SERVER_VERSION pins it; unset or `latest` resolves the newest release.
  # A leading `v` is fine — the tag you copy off the releases page has one.
  local cs_version
  cs_version="${CODE_SERVER_VERSION:-latest}"
  cs_version="${cs_version,,}"
  cs_version="${cs_version#v}"
  case "$cs_version" in
    latest) ;;
    *[!0-9a-z.-]*) die "CODE_SERVER_VERSION='$cs_version' is not a version — use e.g. 4.138.0, or 'latest'" ;;
  esac

  case " $mounts " in
    *" $CONTAINER_CS "*)
      # Linked once, at create: a container keeps its version until
      # `codespace rebuild`, so a new release or a changed pin never swaps the
      # editor under a running codespace. The version is recorded so `gc`
      # knows which unpacked ones are still in use.
      if ! docker exec "$cid" test -x /usr/local/bin/code-server; then
        local cs_v
        cs_v=$(ensure_code_server "$cs_version") || exit 1
        docker exec -u root "$cid" ln -sfn "$CONTAINER_CS/$cs_v/bin/code-server" /usr/local/bin/code-server \
          || die "could not link code-server into the container"
        echo "$cs_v" > "$STATE/$name/code_server"
        note "code-server $cs_v, shared"
      fi
      ;;
    *)
      # A container from before the shared store unpacked its own copy at
      # create; it keeps using that until it is rebuilt.
      docker exec "$cid" sh -c 'command -v code-server' >/dev/null 2>&1 \
        || die "$name has no code-server and predates the shared one — 'codespace rebuild $name'"
      ;;
  esac

  # Real Codespaces injects GITHUB_TOKEN so `gh` works inside the container
  # without a second login. Nothing does that here, so hand the container the
  # VM's own gh token. Read at `up` time — after `gh auth login` or a token
  # change, `codespace up` again to refresh it. Set CONTAINER_GH_TOKEN=0 in
  # /persist/codespace/config to keep the token on the VM instead.
  local gh_token=""
  if [ "${CONTAINER_GH_TOKEN:-1}" != 0 ]; then
    gh_token=$(gh auth token 2>/dev/null || true)
  fi

  local remote_home
  remote_home=$(docker exec -u "$remote_user" "$cid" sh -c 'echo $HOME' 2>/dev/null | tr -d '\r')
  [ -n "$remote_home" ] || remote_home="/home/$remote_user"

  # Secrets go in a 0600 file of their own rather than into /etc/profile.d,
  # which has to stay world-readable for login shells to source it. The gh token
  # rides along as just another entry.
  #
  # Nothing is passed with `docker exec -e`: the file is written with `docker
  # cp` and the editor picks it up because it is started from a login shell, so
  # no value ever appears in a command line on the VM.
  local secretfile="$remote_home/.codespace-secrets"
  local tmpsec
  tmpsec=$(mktemp)
  chmod 600 "$tmpsec"
  [ -n "$gh_token" ] && printf 'export GH_TOKEN=%s\n' "$gh_token" >> "$tmpsec"
  if [ -n "$secrets_json" ] && [ "$secrets_json" != "{}" ]; then
    printf '%s' "$secrets_json" \
      | jq -r 'to_entries[] | "export \(.key)=\(.value|@sh)"' >> "$tmpsec"
  fi
  if [ -s "$tmpsec" ]; then
    docker cp "$tmpsec" "$cid:$secretfile" >/dev/null
    docker exec -u root "$cid" chown "$remote_user" "$secretfile"
    docker exec -u root "$cid" chmod 0600 "$secretfile"
  else
    # Do not leave secrets behind from a previous up.
    docker exec -u root "$cid" rm -f "$secretfile" 2>/dev/null || true
  fi
  rm -f "$tmpsec"
  # Superseded by .codespace-secrets; clear it so an old one cannot linger.
  docker exec -u root "$cid" rm -f "$remote_home/.codespace-token" 2>/dev/null || true

  # Commit signing, at the container's system level for the same reason as the
  # identity: it should not depend on having a dotfiles repo. The launcher has
  # already worked out whether a usable key is reachable and how, so it writes
  # the answer rather than making something downstream re-derive it and risk
  # disagreeing.
  #
  # user.signingkey is the *public* half: `ssh-keygen -Y sign` uses the agent
  # when the private half is unreadable, which is the whole point of agent mode.
  #
  # GIT_SIGNING=vm signs on the VM instead (modules/codespace-auth.nix): git
  # runs the mounted client as gpg.ssh.program, and the key and its agent need
  # not be in the container at all. That is what lets the agent stop being
  # forwarded later (docs/GITHUB-APP.md). Chosen on every `up`, so switching
  # needs no rebuild — only a container created with the mount.
  local signing="" have_auth=0
  case " $mounts " in *" $CONTAINER_AUTH "*) have_auth=1 ;; esac
  case "${GIT_SIGNING:-agent}" in
    vm)
      if [ "$have_auth" = 1 ]; then
        signing=vm
      else
        note "note: GIT_SIGNING=vm, but this container predates the signing service — 'codespace rebuild $name'"
      fi
      ;;
    agent) ;;
    *) die "GIT_SIGNING must be agent or vm (got '${GIT_SIGNING}')" ;;
  esac
  if [ -z "$signing" ] && { [ "$git_ssh" = agent ] || [ "$git_ssh" = keyfile ]; }; then
    signing=key
  fi

  if [ -n "$signing" ]; then
    docker exec -u root "$cid" sh -c '
      set -e
      git config --system gpg.format ssh
      git config --system user.signingkey /mnt/git-ssh/id_ed25519.pub
      git config --system commit.gpgsign true
      git config --system tag.gpgsign true
      [ -r /mnt/git-ssh/allowed_signers ]         && git config --system gpg.ssh.allowedSignersFile /mnt/git-ssh/allowed_signers
      if [ "$1" = vm ]; then
        git config --system gpg.ssh.program "$2/git-sign-codespace"
      else
        git config --system --unset-all gpg.ssh.program || true
      fi
      exit 0
    ' _ "$signing" "$CONTAINER_AUTH" 2>/dev/null || note "note: could not set container git signing config"
  fi

  # With a key available, reach GitHub over SSH even for https remotes, so a
  # repo cloned over https can still be pushed. Tied to authentication, not to
  # signing: VM-side signing needs no key in the container.
  if [ "$git_ssh" = agent ] || [ "$git_ssh" = keyfile ]; then
    docker exec -u root "$cid" \
      git config --system --replace-all url."git@github.com:".insteadOf https://github.com/ 2>/dev/null \
      || note "note: could not set the https→ssh rewrite"
  fi

  # Wire the identity in at the container's *system* level, so `git commit`
  # knows who you are whether or not you use a dotfiles repo. Mounting the file
  # is not enough on its own — something has to include it, and until now only
  # the dotfiles did, so a codespace without them committed with no author.
  #
  # `git config --system` rather than a literal /etc/gitconfig: the devcontainer
  # git feature builds git from source, and the system config path follows its
  # prefix. --replace-all keeps repeated `up` runs idempotent.
  if docker exec "$cid" test -r /mnt/git-ssh/identity 2>/dev/null; then
    docker exec -u root "$cid" \
      git config --system --replace-all include.path /mnt/git-ssh/identity 2>/dev/null \
      || note "note: could not set the git identity include (is git in the image?)"
  fi

  [ -n "${APT_MIRROR:-}" ] && apply_apt_mirror "$cid" "$APT_MIRROR"

  fix_dind_iptables "$cid"

  # Containers come up on UTC, so `date`, log timestamps and the editor's own
  # clock all disagree with the machine you are sitting at.
  #
  # TIMEZONE in the launcher config wins; unset, the container inherits the
  # VM's own zone, so there is one answer rather than two that can drift. On
  # /persist rather than in configuration.nix on purpose: `time.timeZone` is
  # committed to a public repo, and roughly where you live is the kind of thing
  # this repo keeps off GitHub. Set both if you want the VM to match.
  local tz="${TIMEZONE:-}"
  if [ -z "$tz" ]; then
    # From the link target, not /etc/timezone: NixOS does not write that file,
    # and points /etc/localtime into the store.
    tz=$(readlink -f /etc/localtime 2>/dev/null || true)
    case "$tz" in
      */zoneinfo/*) tz="${tz##*/zoneinfo/}" ;;
      *) tz="" ;;
    esac
  fi
  if [ -n "$tz" ]; then
    # Validated, not trusted: it is interpolated into a shell command that runs
    # as root in the container. Zone names are letters, digits, _ + - and /.
    case "$tz" in
      *[!0-9A-Za-z_+/-]*) die "TIMEZONE='$tz' is not a zone name — e.g. Asia/Manila" ;;
    esac
    local tz_status=0
    # Never fatal. A container with no tzdata is still a working codespace, and
    # exit 3 distinguishes that from the command itself going wrong.
    docker exec -u root "$cid" sh -c "
      [ -e /usr/share/zoneinfo/$tz ] || exit 3
      ln -sf /usr/share/zoneinfo/$tz /etc/localtime
      printf '%s\n' '$tz' > /etc/timezone
    " 2>/dev/null || tz_status=$?
    case "$tz_status" in
      0) note "container timezone $tz" ;;
      3) note "note: no zoneinfo for $tz in this image — the container stays on UTC" ;;
      *) note "note: could not set the container timezone (exit $tz_status)" ;;
    esac
  fi

  # Login shells get the git env too; the editor's own terminals inherit it
  # from the code-server process below.
  local envfile
  envfile=$(mktemp)
  {
    echo "export CODESPACE_NAME=$name"
    # Belt and braces next to /etc/localtime above: that covers anything going
    # through libc, TZ covers what reads the variable instead. Only when the
    # zone actually applied, so a container with no tzdata is not told it is on
    # a zone it cannot resolve.
    [ "${tz_status:-1}" = 0 ] && echo "export TZ=$tz"
    case "$git_ssh" in
      agent)
        echo "export SSH_AUTH_SOCK=$agent_sock"
        echo "export GIT_SSH_COMMAND=\"$ssh_cmd\""
        ;;
      keyfile)
        echo "export GIT_SSH_COMMAND=\"$ssh_cmd\""
        ;;
    esac
    # Deliberately unexpanded: $HOME has to resolve inside the container at
    # login, not out here.
    # shellcheck disable=SC2016
    echo '[ -r "$HOME/.codespace-secrets" ] && . "$HOME/.codespace-secrets"'
  } > "$envfile"
  docker cp "$envfile" "$cid:/etc/profile.d/codespace.sh" >/dev/null
  docker exec -u root "$cid" chmod 0644 /etc/profile.d/codespace.sh
  rm -f "$envfile"

  # code-server has to be told which folder to open. Without it the editor comes
  # up with no workspace at all: the code is mounted and the container is fine,
  # but the file tree is empty and terminals start in $HOME.
  #
  # A container created before editors moved onto sockets has no
  # $CONTAINER_EDITOR mount, and `up` cannot add one: mounts are fixed at
  # create. Its editor listens on a TCP port nginx never forwards to.
  #
  # Shell-only rather than an error: the container is up and fine by this
  # point, and its container layer may hold things worth getting out before a
  # rebuild discards them — Claude Code's state in $HOME, for one.
  case " $mounts " in
    *" $CONTAINER_EDITOR "*) ;;
    *)
      echo
      echo "  $name is up — shell only"
      echo "  Its container predates editors moving behind nginx, so it has no editor socket."
      echo
      echo "  codespace shell $name       a terminal inside it"
      echo "  codespace rebuild $name     brings the editor back. The checkout and volumes are"
      echo "                              kept; everything else in the container, \$HOME included,"
      echo "                              is not — take out what you need first."
      return 0
      ;;
  esac

  # Liveness is asked of the editor itself, over its socket, not inferred from a
  # process listing. `pgrep -f` was doing the latter and getting it wrong: the
  # shell running the check had /tmp/code-server.args on its own command line,
  # which supplied "code-server", while the pattern text supplied the rest, and
  # `.*` bridged the two — so the check matched itself and reported a dead
  # editor as running. After a VM reboot the args file survives in the container
  # while the process does not, which is exactly when that mattered.
  #
  # Asking the endpoint is also the thing we actually care about: an editor that
  # is running but not answering is no more use than one that is gone.
  #
  # --auth none, because nothing reaches this socket except nginx, which has
  # already checked the client certificate — and no password means nothing
  # here holds a credential for any other editor.
  local sock="$CONTAINER_EDITOR/editor.sock"
  local want="$sock $remote_ws" have="" editor_live=0
  editor_answers "$port" && editor_live=1
  # The arguments are recorded next to the log so an editor started by an older
  # version of this script — or on a different folder — is replaced rather than
  # left running.
  have=$(docker exec "$cid" cat /tmp/code-server.args 2>/dev/null || true)

  if [ "$editor_live" = 0 ] || [ "$have" != "$want" ]; then
    note "starting editor on $remote_ws"
    docker exec -u root "$cid" sh -c "pkill -f '[c]ode-server.*--(bind-addr|socket)' >/dev/null 2>&1; exit 0"
    local -a envargs=()
    case "$git_ssh" in
      agent)   envargs+=(-e "SSH_AUTH_SOCK=$agent_sock" -e "GIT_SSH_COMMAND=$ssh_cmd") ;;
      keyfile) envargs+=(-e "GIT_SSH_COMMAND=$ssh_cmd") ;;
    esac
    # 0660 with nginx's group, inherited from the setgid directory.
    docker exec -d -u "$remote_user" ${envargs[@]+"${envargs[@]}"} "$cid" bash -lc \
      "printf '%s' \"$want\" > /tmp/code-server.args
       exec code-server --socket $sock --socket-mode 660 --auth none \
         --disable-telemetry --disable-update-check \
         \"$remote_ws\" >/tmp/code-server.log 2>&1"
  fi

  note "waiting for the editor"
  local i
  for i in $(seq 1 30); do
    editor_answers "$port" && break
    if [ "$i" = 30 ]; then
      note "the editor is not answering on its socket:"
      note "    codespace logs $name"
      die "editor did not answer"
    fi
    sleep 1
  done
  # The editor answering is half of it; nginx is the other half, and the
  # launcher cannot test it end to end without the client key, which it
  # deliberately cannot read.
  systemctl is-active --quiet nginx.service \
    || note "warning: nginx is not running, so the editor is unreachable: systemctl status nginx"

  echo
  echo "  $name is up"
  echo "  https://localhost:$port/"
  [ "$git_ssh" = agent ] && echo "  git: ssh agent forwarded (key stays on the VM)"
  [ "$signing" = vm ] && echo "  git: commits signed on the VM (GIT_SIGNING=vm)"
  [ "$git_ssh" = keyfile ] && echo "  git: key from /persist/git"
  [ "$git_ssh" = locked ] && echo "  git: UNAVAILABLE — key is passphrase-locked, run 'ssh-add $key'"
  [ -n "$gh_token" ] && echo "  gh:  authenticated with the VM's token"
  [ "$have_vm" = 1 ] && echo "  vm:  control socket mounted — 'vm help' inside"
  [ -z "$git_ssh" ] && echo "  git: no credentials mounted (see 'Git inside containers' in the README)"
  echo
  echo "  F1 opens the command palette. Ctrl+Shift+P is a Firefox private window."
  if [ -d "$TLS_EXPORT" ]; then
    echo
    echo "  Not imported yet? $TLS_EXPORT holds the client certificate for Firefox:"
    echo "  README, 'Editor access'. Delete $TLS_EXPORT once it is imported."
  fi
}

cmd_down() {
  [ $# -ge 1 ] || usage
  local name cid
  name=$(slugify "$1")
  cid=$(container_of "$name")
  if [ -n "$cid" ]; then
    note "stopping $name"
    docker stop "$cid" >/dev/null
  else
    note "$name is not running"
  fi
}

cmd_new() {
  [ $# -ge 1 ] || usage
  local name
  name=$(slugify "$1")
  [ -n "$name" ] || die "give the codespace a name"
  # Before mkdir, so a refused name leaves nothing behind.
  reject_reserved "$name"

  if [ -e "$REPOS/$name" ] && [ ! -d "$REPOS/$name" ]; then
    die "$REPOS/$name exists and is not a directory"
  fi

  if [ -d "$REPOS/$name" ]; then
    note "$REPOS/$name already exists — starting it"
  else
    note "creating an empty workspace at $REPOS/$name"
    mkdir -p "$REPOS/$name"
  fi

  # Deliberately not `git init`: an empty directory is the whole point, and
  # guessing that you want a repo here would be presumptuous.
  cmd_up "$name"
}

# A terminal inside a codespace, from the VM — so you can work from Windows
# Terminal instead of the browser. Not sshd in the container: that would mean a
# daemon and authorised keys in every image, plus another forwarded port per
# codespace, to reach something `docker exec` already reaches through the SSH
# session you are sitting in.
# Your own secrets, the way Codespaces secrets work: KEY=value lines in
# /persist/codespace/secrets, plus optional per-codespace overrides in
# /persist/codespace/<name>/secrets. Emitted as JSON for --secrets-file.
#
# Parsed with jq, never sourced. This is user data, and sourcing it would run
# whatever happens to be in the file as shell.
collect_secrets() {
  local name="$1" f
  for f in "$STATE/secrets" "$STATE/$name/secrets"; do
    [ -r "$f" ] || continue
    # A secret readable by anyone on the VM is not much of a secret.
    case "$(stat -c %a "$f")" in
      600|400) ;;
      *) note "warning: $f is mode $(stat -c %a "$f"); chmod 600 it" ;;
    esac
    cat "$f"
  done | jq -R -s '
    split("\n")
    | map(select(test("^[A-Za-z_][A-Za-z0-9_]*=")))
    | map(capture("^(?<key>[A-Za-z_][A-Za-z0-9_]*)=(?<value>.*)$"))
    | from_entries
  '
}

# Point the container's apt at a nearer Ubuntu mirror. Opt-in via APT_MIRROR in
# the launcher config, because the right mirror depends entirely on where you
# are.
#
# This runs after the image is built, so it speeds up apt *inside* the container
# — your own installs, postCreateCommand, anything later. It cannot speed up
# devcontainer features, which apt-install during the build, before any of this
# exists.
apply_apt_mirror() {
  local cid="$1" mirror="${2%/}/"

  # Nothing to do if the sources already point somewhere else, so a repeat `up`
  # leaves them alone.
  docker exec "$cid" sh -c \
    'grep -rqE "https?://([a-z0-9.-]+\.)?(archive|security)\.ubuntu\.com" /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null' \
    2>/dev/null || return 0

  note "pointing apt at $mirror"
  # Both layouts: deb822 .sources (Ubuntu 24.04 onward) and legacy .list files.
  # Regional mirrors like azure.archive.ubuntu.com are matched too.
  docker exec -u root "$cid" sh -c '
    mirror="$1"
    files=$(ls /etc/apt/sources.list /etc/apt/sources.list.d/*.sources                /etc/apt/sources.list.d/*.list 2>/dev/null) || true
    [ -n "$files" ] || exit 0
    sed -i -E "s#https?://([a-z0-9.-]+\.)?(archive|security)\.ubuntu\.com/ubuntu/?#${mirror}#g" $files
  ' _ "$mirror" 2>/dev/null || { note "note: could not rewrite apt sources"; return 0; }

  # No apt-get update here. It cost ~10 s of every create, and bought nothing
  # a stock container has: devcontainers base images empty /var/lib/apt/lists
  # when they are built, so a fresh container needs `apt-get update` before its
  # first install whether or not the sources were rewritten. In the background
  # it would race the user instead: apt fails at once on the lists lock rather
  # than waiting — DPkg::Lock::Timeout does not cover that lock (tested, apt
  # 3.2) — so an `apt-get update` in the first seconds would error out.
}

# The docker-in-docker feature points iptables at iptables-legacy on every
# Debian/Ubuntu release except resolute, whose kernel dropped the legacy tables.
# So has this VM's: 6.18 with CONFIG_NETFILTER_XTABLES_LEGACY unset, meaning no
# legacy nat or filter table exists at all. A container borrows the VM's kernel,
# so the inner dockerd fails creating its first chain, the feature's init script
# gives up after five tries, and `devcontainer up` reports success regardless.
#
# Same rules, other backend: iptables-nft takes identical syntax and translates
# to nftables, which this kernel has. The feature switches during the image
# build and dockerd starts from the entrypoint before anything here runs, so
# the first start is lost; this repairs it and restarts. The alternative lives
# in the container layer, so later starts of the same container are fine on
# their own and only a recreate comes back through here.
#
# Here and not in a project's postCreateCommand: it is a property of this VM's
# kernel, and real Codespaces still has the legacy tables.
fix_dind_iptables() {
  local cid="$1"

  # dockerd too, not just the init script: docker-outside-of-docker installs a
  # docker-init.sh at the same path, with only the CLI and nothing to fix.
  docker exec "$cid" sh -c 'test -x /usr/local/share/docker-init.sh && command -v dockerd' \
    >/dev/null 2>&1 || return 0

  # Asked of iptables itself, so a container already switched — or a base
  # image that ships nft — costs one exec and nothing else.
  case "$(docker exec -u root "$cid" iptables -V 2>/dev/null)" in
    *legacy*) ;;
    *) return 0 ;;
  esac

  note "docker-in-docker: switching to iptables-nft (this kernel has no legacy tables)"
  docker exec -u root "$cid" sh -c '
    command -v iptables-nft >/dev/null || exit 3
    update-alternatives --set iptables  /usr/sbin/iptables-nft
    update-alternatives --set ip6tables /usr/sbin/ip6tables-nft
  ' >/dev/null 2>&1 || {
    note "note: could not switch iptables to nft — docker will not run inside this codespace"
    return 0
  }

  # The entrypoint may still be in its retry loop — five rounds of five
  # one-second probes — and would pick the new backend up on its own next
  # round. Restarting underneath it would race two dockerds for one pid file,
  # so wait until the loop is certainly over. Timed from the container's own
  # start, not inferred from a process listing (§8: that lies).
  local started now
  started=$(date -d "$(docker inspect -f '{{.State.StartedAt}}' "$cid")" +%s 2>/dev/null || echo 0)
  now=$(date +%s)
  while [ $((now - started)) -lt 40 ]; do
    docker exec "$cid" docker info >/dev/null 2>&1 && { note "docker-in-docker: dockerd is up"; return 0; }
    sleep 2
    now=$(date +%s)
  done

  # Through the feature's own script rather than a bare `dockerd`, so its
  # cgroup nesting, DNS and address-pool handling still apply. Detached,
  # because it blocks through its retries and dockerd must outlive the exec.
  if ! docker exec "$cid" docker info >/dev/null 2>&1; then
    docker exec -u root "$cid" sh -c 'pkill dockerd; pkill containerd; :' >/dev/null 2>&1
    docker exec -d -u root "$cid" /usr/local/share/docker-init.sh
  fi

  # Probe the daemon itself; that is the property worth knowing.
  for _ in $(seq 30); do
    docker exec "$cid" docker info >/dev/null 2>&1 && { note "docker-in-docker: dockerd is up"; return 0; }
    sleep 1
  done
  note "note: dockerd did not come up inside the codespace — last of /tmp/dockerd.log:"
  docker exec "$cid" tail -n 5 /tmp/dockerd.log >&2 2>/dev/null || true
}

# Only /workspaces/<the repo> is a mount. Anything else under /workspaces, and
# anything in $HOME, lives in the container's writable layer and dies with it.
# Say so before throwing the container away, rather than after.
warn_ephemeral() {
  local name="$1" cid kept entry found=0
  cid=$(container_of "$name") || true
  [ -n "$cid" ] || return 0

  # Every bind mount under /workspaces is backed by something on /persist — the
  # project itself and, when enabled, refs. Ask docker rather than assuming, so
  # adding a mount later cannot turn into a false alarm.
  kept=$(docker inspect "$cid" \
    | jq -r '.[0].Mounts[] | select(.Destination | startswith("/workspaces/")) | .Destination' \
    2>/dev/null | xargs -r -n1 basename || true)

  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    printf '%s\n' "$kept" | grep -qxF "$entry" && continue
    if [ "$found" = 0 ]; then
      note "warning: these are not on /persist and will be lost:"
      found=1
    fi
    note "             /workspaces/$entry"
  done < <(docker exec "$cid" sh -c 'ls -1 /workspaces 2>/dev/null' 2>/dev/null || true)

  [ "$found" = 1 ] && note "         only the mounted directories are on /persist"
  return 0
}

cmd_shell() {
  [ $# -ge 1 ] || usage
  local name cid ruser rws use_tmux=1
  name=$(slugify "$1"); shift

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-tmux) use_tmux=0; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  cid=$(container_of "$name")
  [ -n "$cid" ] || die "$name is not running — 'codespace up $name' first"
  touch_used "$name"

  # From state where `up` left it; otherwise dug back out of the container, so
  # this still works for one created before that was recorded.
  ruser=$(cat "$STATE/$name/remote_user" 2>/dev/null || true)
  if [ -z "$ruser" ]; then
    ruser=$(docker inspect "$cid" \
      | jq -r '[.[0].Config.Labels."devcontainer.metadata" // "[]" | fromjson | .[]?.remoteUser // empty] | last // empty' \
      2>/dev/null || true)
  fi
  [ -n "$ruser" ] || ruser=root

  rws=$(cat "$STATE/$name/remote_workspace" 2>/dev/null || true)
  if [ -z "$rws" ]; then
    rws=$(docker inspect "$cid" \
      | jq -r '.[0].Mounts[] | select(.Destination | startswith("/workspaces")) | .Destination' \
      2>/dev/null | head -1 || true)
  fi
  [ -n "$rws" ] || rws=/

  # -t only when there is a terminal to allocate, so `codespace shell x -- cmd`
  # stays usable in a pipe or a script.
  local -a dexec=(docker exec -i)
  [ -t 0 ] && dexec+=(-t)
  dexec+=(-u "$ruser" -w "$rws" "$cid")

  # A one-shot command never wants a persistent session wrapped around it.
  if [ $# -gt 0 ]; then
    exec "${dexec[@]}" bash -lc "$*"
  fi

  # tmux lives on the VM, not in the container: it survives your SSH dropping,
  # and it does not require every image to ship tmux. attach-or-create, so
  # reconnecting puts you back in the same shell rather than a fresh one.
  if [ "$use_tmux" = 1 ] && [ -z "${TMUX:-}" ] && [ -t 0 ]; then
    local session cmd
    session="cs-$(echo "$name" | tr '.:' '--')"
    cmd=$(printf '%q ' "${dexec[@]}" bash -l)
    exec tmux new-session -A -s "$session" "$cmd"
  fi

  exec "${dexec[@]}" bash -l
}

cmd_rm() {
  [ $# -ge 1 ] || usage
  local name cid keep_repo=1 drop_volumes=0
  name=$(slugify "$1"); shift

  # A loop rather than a test on $2: the flags combine, and the old positional
  # check silently ignored anything after the first one.
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) keep_repo=0; shift ;;
      --volume | --volumes) drop_volumes=1; shift ;;
      *) die "unknown option '$1' for rm (try --repo, --volume)" ;;
    esac
  done

  # Which checkout this codespace used, read before its state goes: the path it
  # recorded at `up`, else the note an earlier `rm` left, else — only for a
  # codespace removed before those notes existed — the conventional
  # $REPOS/<name>. Deriving it from the name alone deleted the wrong directory
  # when a codespace had been started from a path elsewhere and something else
  # of the same name lived in $REPOS.
  local ws=""
  if [ -f "$STATE/$name/workspace" ]; then ws=$(cat "$STATE/$name/workspace")
  elif [ -f "$REMOVED/$name" ]; then ws=$(cat "$REMOVED/$name")
  elif [ -d "$REPOS/$name" ]; then ws="$REPOS/$name"; fi

  # Refused here, before anything is touched. remove_checkout checks again at
  # the end, but by then the container and its state would already be gone,
  # leaving a half-done rm behind an error that reads as though nothing
  # happened. `codespace rm dev-vm --repo` would have done that to the flake's
  # own codespace, whose checkout is /persist/dev-vm.
  if [ "$keep_repo" = 0 ] && [ -n "$ws" ] && [ -e "$ws" ] && ! under_repos "$ws"; then
    die "not removing $name: --repo only deletes checkouts directly under $REPOS, and this one is $(realpath -e "$ws"). Nothing was changed. Drop --repo to remove just the codespace."
  fi

  warn_ephemeral "$name"

  cid=$(container_any "$name")

  # Read while the container still exists: its mount list is the only record of
  # which volumes were its own, and `docker rm` takes it with it.
  local -a vols=()
  local v
  if [ "$drop_volumes" = 1 ]; then
    if [ -n "$cid" ]; then
      while IFS= read -r v; do
        [ -n "$v" ] && vols+=("$v")
      done < <(docker inspect "$cid" \
        | jq -r '.[0].Mounts[]? | select(.Type == "volume") | .Name' 2>/dev/null || true)
    else
      note "no container for $name — nothing left to say which volumes were its"
    fi
  fi

  if [ -n "$cid" ]; then
    note "removing container for $name"
    docker rm -f "$cid" >/dev/null
  fi

  # Only after the container is gone: docker refuses to remove a volume any
  # container still references, stopped ones included.
  #
  # Every attached volume is offered, not just the ones named after this
  # codespace, because the mount list is the only honest answer to "which were
  # its". That includes deliberately shared ones — dev-vm-nix-store holds the
  # nixpkgs closure and is expensive to refill — so each outcome is reported by
  # name. A volume another codespace is still using survives on docker's own
  # refusal, which is the check worth trusting here.
  for v in ${vols[@]+"${vols[@]}"}; do
    if docker volume rm "$v" >/dev/null 2>&1; then
      note "removed volume $v"
    else
      note "kept volume $v — another container still references it"
    fi
  done

  # Drops the port reservation and any generated devcontainer.json, so the next
  # `up` starts clean. The checkout is left alone unless asked: it is the one
  # thing here that might hold work that is not pushed yet.
  rm -rf "${STATE:?}/$name"

  if [ "$keep_repo" = 0 ]; then
    remove_checkout "$name" "$ws"
  elif [ -n "$ws" ]; then
    mkdir -p "$REMOVED"
    printf '%s\n' "$ws" > "$REMOVED/$name"
    if [ -d "$ws" ]; then
      echo "  the checkout is still at $ws"
      if under_repos "$ws"; then
        echo "  'codespace rm $name --repo' deletes that too"
      else
        echo "  it is not directly under $REPOS once symlinks are followed, so --repo will not delete it"
      fi
    fi
  fi
}

# Deletes a codespace's checkout, but only one directly under $REPOS — where
# `up <url>` clones and `new` creates. A codespace started from a path
# elsewhere (`up /persist/refs/foo`, or any directory) points at something this
# script did not make and may not be the only user of, so that stays yours to
# delete. Compared after realpath, so a symlink cannot walk the check outside.
under_repos() {
  local real repos
  real=$(realpath -e "$1" 2>/dev/null) || return 1
  repos=$(realpath -e "$REPOS" 2>/dev/null) || return 1
  [ "$(dirname "$real")" = "$repos" ]
}

remove_checkout() {
  local name="$1" ws="$2" real
  if [ -z "$ws" ] || [ ! -e "$ws" ]; then
    note "no checkout left to remove for $name${ws:+ (was $ws)}"
    rm -f "$REMOVED/$name"
    return 0
  fi
  real=$(realpath -e "$ws")
  under_repos "$real" \
    || die "not deleting $real: --repo only removes checkouts directly under $REPOS. Delete it by hand if you mean to."
  note "removing $real"
  rm -rf "${real:?}"
  rm -f "$REMOVED/$name"
}

cmd_list() {
  local size=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--size) size=1; shift ;;
      *) die "unknown option '$1' for list (try --size)" ;;
    esac
  done
  if [ "$size" = 1 ]; then list_sizes; return; fi

  local dir name port cid status idle
  printf '%-22s %-6s %-8s %-6s %s\n' NAME PORT STATE IDLE URL
  for dir in "$STATE"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    [ -f "$dir/port" ] || continue
    port=$(cat "$dir/port")
    read -r status idle <<<"$(codespace_state "$name")"
    printf '%-22s %-6s %-8s %-6s %s\n' "$name" "$port" "$status" "$idle" "https://localhost:$port/"
  done
}

# IDLE is what the retention sweep is counting, so it is only meaningful for the
# state the sweep looks at. A running codespace is never a candidate, and an
# absent one has nothing left to reclaim.
codespace_state() {
  if [ -n "$(container_of "$1")" ]; then echo "running -"
  elif [ -n "$(container_any "$1")" ]; then echo "stopped $(idle_days "$1")d"
  else echo "absent -"; fi
}

# Bytes to 1.7G; "-" stays "-" for a part that does not exist.
human() {
  case "$1" in
    -|"") echo "-" ;;
    *) numfmt --to=iec "$1" ;;
  esac
}

# Bytes under a path, or 0. Files a container created as some other uid can be
# unreadable; du still totals what it can, which is the useful answer.
du_bytes() {
  [ -e "$1" ] || { echo 0; return; }
  du -sxb "$1" 2>/dev/null | cut -f1 || echo 0
}

# Only what a codespace has to itself is charged to it, so the rows plus the
# footer add up to what is on disk rather than counting a shared thing twice.
# Base layers shared between images, an image two codespaces were built from,
# and a volume mounted in more than one container (the dev-vm Nix store) are
# real space with no honest single owner, and go in the footer.
#
# One request to the engine API rather than `docker system df -v`, which only
# prints rounded human sizes. Pinned to v1.55 (Docker 29): the response shape
# changed in that version — ImageUsage/ContainerUsage/… with Items only under
# verbose=true — and a pinned version is answered in the shape it had, so a
# newer daemon cannot silently change what this parses. Checked against the
# docker-v29.7.2 swagger, including that SharedSize and RefCount can be -1 for
# "not calculated", which is shown as unknown rather than as zero.
list_sizes() {
  note "measuring — docker walks every file in every volume, so this can take a while"
  local df
  df=$(curl -fsS --unix-socket /var/run/docker.sock \
    "http://localhost/v1.55/system/df?verbose=true") \
    || die "could not read disk usage from docker (is the daemon up, and are you in the docker group?)"

  # Per codespace: name, writable layer, unique image size, own volumes.
  # "?" is unknown: the daemon reported -1, or the image is shared.
  local rows
  rows=$(printf '%s' "$df" | jq -r '
    (.VolumeUsage.Items // [] | map({key: .Name, value: .UsageData}) | from_entries) as $vol
    | (.ImageUsage.Items // [] | map({key: .Id, value: .}) | from_entries) as $img
    | .ContainerUsage.Items // [] | .[]
    | select(.Labels.codespace != null)
    | ($img[.ImageID]) as $i
    | [ .Labels.codespace,
        (.SizeRw // 0),
        (if $i == null or $i.SharedSize < 0 then "?"
         elif $i.Containers == 1 then $i.Size - $i.SharedSize
         else "shared" end),
        ([.Mounts[]? | select(.Type == "volume") | $vol[.Name]
          | select(. != null and .RefCount == 1 and .Size >= 0) | .Size] | add // 0)
      ] | @tsv')

  local dir name status idle rw img vols repo total ws part n a b c
  printf '%-22s %-8s %9s %9s %9s %9s %9s\n' NAME STATE CONTAINER IMAGE VOLUMES REPO TOTAL
  for dir in "$STATE"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    [ -f "$dir/port" ] || continue
    read -r status idle <<<"$(codespace_state "$name")"
    rw=- img=- vols=-
    if [ "$status" != absent ]; then
      while IFS=$'\t' read -r n a b c; do
        [ "$n" = "$name" ] && { rw=$a img=$b vols=$c; break; }
      done <<<"$rows"
    fi
    ws=$(cat "$dir/workspace" 2>/dev/null || true)
    repo=$(du_bytes "$ws")
    total=$repo
    for part in "$rw" "$img" "$vols"; do
      case "$part" in ''|*[!0-9]*) ;; *) total=$((total + part)) ;; esac
    done
    case "$img" in shared|"?") ;; *) img=$(human "$img") ;; esac
    printf '%-22s %-8s %9s %9s %9s %9s %9s\n' "$name" "$status" \
      "$(human "$rw")" "$img" "$(human "$vols")" "$(human "$repo")" "$(human "$total")"
  done

  # Everything with no single owner, so the whole adds up. jq picks the
  # numbers, bash formats them, so the footer reads like the table above.
  echo
  echo "shared and unowned:"
  local label bytes what
  while IFS=$'\t' read -r label bytes what; do
    printf '  %-16s %9s  %s\n' "$label" "$(human "$bytes")" "$what"
  done < <(printf '%s' "$df" | jq -r --arg rows "$rows" '
    ($rows | split("\n") | map(split("\t") | (.[2] | tonumber?) // 0) | add // 0) as $charged
    | (.VolumeUsage.Items // []) as $v
    | ($v | map(select(.UsageData.RefCount == 0))) as $u
    | ([.ContainerUsage.Items // [] | .[] | select(.Labels.codespace == null) | .SizeRw // 0] | add // 0) as $other
    | ( [ $v[] | select(.UsageData.RefCount > 1 and .UsageData.Size >= 0)
          | ["shared volume", .UsageData.Size, "\(.Name), in \(.UsageData.RefCount) containers"] ]
      + (if ($u | length) > 0 then
          [["unattached", ([$u[].UsageData.Size | select(. >= 0)] | add // 0),
            "\($u | length) volume(s) no container uses — codespace rm --volume, or docker volume rm"]]
         else [] end)
      + [["images", ((.ImageUsage.TotalSize // 0) - $charged), "shared layers, and images not charged above"]]
      + [["build cache", (.BuildCacheUsage.TotalSize // 0), "docker builder prune"]]
      + (if $other > 0 then [["other containers", $other, "not codespaces"]] else [] end)
      ) | .[] | @tsv')
  printf '  %-16s %9s  %s\n' "refs" "$(human "$(du_bytes "$REFS")")" "$REFS"
  printf '  %-16s %9s  %s\n' "code-server" "$(human "$(du_bytes "$CS_STORE")")" "$CS_STORE, shared by every codespace"
}

# The Codespaces retention behaviour, on a real last-used clock. Deliberately
# narrower than the real thing: GitHub deletes the whole codespace, workspace
# and all, and that is its most resented behaviour. Here only the container
# goes. The checkout in $REPOS, the port reservation and any generated
# devcontainer.json stay, so `codespace up <name>` brings it back on the same
# URL — what is lost is the container layer, the same thing `codespace rebuild`
# discards. Deleting a checkout stays a thing you ask for, via `rm --repo`.
cmd_gc() {
  local dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n | --dry-run) dry=1; shift ;;
      *) usage ;;
    esac
  done

  load_config
  local days="${RETENTION_DAYS:-$RETENTION_DAYS_DEFAULT}"
  case "$days" in
    '' | *[!0-9]*) die "RETENTION_DAYS must be a whole number of days, got '$days'" ;;
  esac
  if [ "$days" -eq 0 ]; then
    note "RETENTION_DAYS=0 — retention is off, nothing to sweep"
    return 0
  fi

  local dir name cid idle swept=0
  for dir in "$STATE"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    cid=$(container_any "$name")
    # Nothing to reclaim, or still running — a codespace you left up is in use
    # by definition, however long ago you last typed in it.
    [ -n "$cid" ] || continue
    [ -z "$(container_of "$name")" ] || continue

    idle=$(idle_days "$name")
    [ "$idle" -ge "$days" ] || continue

    if [ "$dry" = 1 ]; then
      note "would remove $name (idle ${idle}d >= ${days}d)"
    else
      note "removing container for $name (idle ${idle}d >= ${days}d); checkout kept"
      docker rm "$cid" >/dev/null || note "could not remove the container for $name"
    fi
    swept=$(( swept + 1 ))
  done
  [ "$swept" -gt 0 ] || note "nothing idle past ${days}d"

  prune_code_server "$dry"
}

# Drops unpacked code-server versions no codespace uses. "Uses" is what `up`
# recorded at create, in $STATE/<name>/code_server — a stopped container cannot
# be asked. The newest is always kept, so the next create needs no download.
prune_code_server() {
  local dry=$1 d v newest keep
  [ -d "$CS_STORE" ] || return 0
  newest=$(newest_code_server) || return 0
  keep=$(cat "$STATE"/*/code_server 2>/dev/null || true)
  for d in "$CS_STORE"/*/; do
    [ -d "$d" ] || continue
    v=$(basename "$d")
    [ "$v" = "$newest" ] && continue
    printf '%s\n' "$keep" | grep -qxF "$v" && continue
    if [ "$dry" = 1 ]; then
      note "would remove code-server $v (no codespace uses it)"
      continue
    fi
    note "removing code-server $v (no codespace uses it)"
    sudo chattr -i "$CS_STORE"
    sudo find "$CS_STORE/$v" ! -type l -exec chattr -i {} +
    sudo rm -rf "${CS_STORE:?}/$v"
    sudo chattr +i "$CS_STORE"
  done
}

cmd_logs() {
  [ $# -ge 1 ] || usage
  local name cid
  name=$(slugify "$1")
  cid=$(container_of "$name") || true
  [ -n "$cid" ] || die "$name is not running"
  docker exec "$cid" cat /tmp/code-server.log
}

[ $# -ge 1 ] || usage 0
sub="$1"; shift

# --config for the commands that create containers, taken out here so that
# cmd_up's positional arguments stay as they were.
case "$sub" in
  up|new|blank|rebuild)
    rest=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --config) [ $# -ge 2 ] || die "--config needs a value: repo, template, plain, auto, or a path"
                  CONFIG_CHOICE=$2; shift 2 ;;
        --config=*) CONFIG_CHOICE=${1#--config=}; shift ;;
        *) rest+=("$1"); shift ;;
      esac
    done
    set -- ${rest[@]+"${rest[@]}"}
    ;;
esac
case "$sub" in
  up)    cmd_up "$@" ;;
  new|blank) cmd_new "$@" ;;
  rebuild)
         [ $# -ge 1 ] || usage
         cmd_up "$1" recreate ;;
  down)  cmd_down "$@" ;;
  shell|sh) cmd_shell "$@" ;;
  rm|delete) cmd_rm "$@" ;;
  list|ls) cmd_list "$@" ;;
  logs)  cmd_logs "$@" ;;
  gc)    cmd_gc "$@" ;;
  -h|--help|help) usage 0 ;;
  *)     die "unknown command '$sub' (try: up, new, shell, rebuild, down, rm, list, logs, gc)" ;;
esac
