# codespace — bring dev containers up and down, Codespaces style.
#
#   codespace up <url|path|name>   create/start a dev container and its editor
#   codespace new <name>           the same, on an empty workspace — no repo
#   codespace rebuild <name>       recreate the container, keeping the port
#   codespace shell <name>         a terminal inside it, in a tmux on the VM
#   codespace down <name>          stop it (the CLI has no `down` of its own)
#   codespace rm <name> [--repo]   delete the container; --repo drops the checkout
#   codespace list                 what exists, on which port
#   codespace logs <name>          editor log, for when the URL does not answer
#
# No shebang: this is built by modules/codespace.nix with
# pkgs.writeShellApplication, which supplies one and runs shellcheck.

PORT_MIN=8001
PORT_MAX=8010
REPOS=/persist/repos
REFS=/persist/refs
# Mounted at /workspaces/$REFS_NAME, which makes it a reserved codespace name:
# a codespace called the same thing would land on the same path.
REFS_NAME=refs
STATE=/persist/codespace
PW_FILE=/persist/code-server/pw
EDITOR_PORT=8080

die() { echo "codespace: $*" >&2; exit 1; }
# Progress goes to stderr so that functions which echo a result can be used in
# a command substitution without their chatter landing in the result.
note() { echo "==> $*" >&2; }

usage() {
  cat >&2 <<'USAGE'
usage:
  codespace up <url|path|name>   create/start a dev container and its editor
  codespace new <name>           the same, on an empty workspace — no repo
  codespace rebuild <name|path>  recreate it from scratch, keeping the port
  codespace shell <name>         a terminal inside it, in a tmux on the VM
  codespace down <name>          stop it, keeping the container
  codespace rm <name> [--repo]   delete the container; --repo drops the checkout
  codespace list                 what exists, on which port
  codespace logs <name>          editor log, for when the URL does not answer
USAGE
  exit "${1:-1}"
}

# Container-safe name: docker labels and systemd unit instances both dislike
# most punctuation.
slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's![^a-z0-9._-]!-!g; s!^-*!!; s!-*$!!'; }

# Accepts a git URL, an absolute path, or the name of something already in
# /persist/repos. Echoes "<name> <workspace-folder>".
# Refused rather than allowed to shadow: a codespace called $REFS_NAME mounts
# its own workspace over /workspaces/$REFS_NAME, and every reference repo
# silently disappears from that container. Checked against the *resolved* name,
# because a URL like github.com/someone/refs also lands on it.
reject_reserved() {
  [ "$1" = "$REFS_NAME" ] || return 0
  die "'$REFS_NAME' is reserved — /workspaces/$REFS_NAME is the shared reference mount.
  Use another name: git clone <url> $REPOS/${REFS_NAME}-something && codespace up ${REFS_NAME}-something
  Reference checkouts themselves go in $REFS, no codespace needed."
}

resolve_workspace() {
  local target="$1" name dir

  # A bare `codespace up refs` never resolves to anything, so catch it here for
  # the useful message rather than letting it fall through to "no such repo".
  case "$target" in
    *://*|*@*:*|*/*) ;;
    *) reject_reserved "$(slugify "$target")" ;;
  esac

  # A codespace that already exists is addressable by name alone, so that
  # `up`/`rebuild` take the same argument as `down`/`logs` once it is created.
  name=$(slugify "$target")
  if [ -f "$STATE/$name/workspace" ]; then
    dir=$(cat "$STATE/$name/workspace")
    if [ -d "$dir" ]; then
      reject_reserved "$name"
      echo "$name $dir"; return
    fi
  fi

  if [ -d "$target" ]; then
    dir=$(realpath "$target")
    name=$(slugify "$(basename "$dir")")
    reject_reserved "$name"
    echo "$name $dir"; return
  fi

  if [ -d "$REPOS/$target" ]; then
    name=$(slugify "$target")
    reject_reserved "$name"
    echo "$name $REPOS/$target"; return
  fi

  case "$target" in
    *://*|*@*:*|github.com/*|gitlab.com/*) ;;
    *) die "no such repo '$target' — give a git URL, a path, or a name under $REPOS" ;;
  esac

  local url="$target"
  case "$url" in
    github.com/*|gitlab.com/*) url="https://$url" ;;
  esac

  name=$(slugify "$(basename "${url%.git}")")
  # Before the clone, so a reserved name costs nothing.
  reject_reserved "$name"
  dir="$REPOS/$name"
  if [ ! -d "$dir" ]; then
    note "cloning $url -> $dir"
    git clone "$url" "$dir" >&2 || die "clone failed"
  fi
  echo "$name $dir"
}

port_in_use() {
  local port="$1" other
  for other in "$STATE"/*/port; do
    [ -e "$other" ] || continue
    [ "$(dirname "$other")" = "$STATE/$2" ] && continue
    [ "$(cat "$other")" = "$port" ] && return 0
  done
  return 1
}

# Sticky: a codespace keeps its port, so bookmarks survive a down/up.
allocate_port() {
  local name="$1" port
  if [ -f "$STATE/$name/port" ]; then
    cat "$STATE/$name/port"; return
  fi
  for port in $(seq "$PORT_MIN" "$PORT_MAX"); do
    if ! port_in_use "$port" "$name"; then
      echo "$port"; return
    fi
  done
  die "all ports $PORT_MIN-$PORT_MAX are taken; 'codespace list' then 'codespace down' one"
}

container_of() { docker ps -q --filter "label=codespace=$1" | head -1; }
container_any() { docker ps -aq --filter "label=codespace=$1" | head -1; }

editor_password() {
  [ -r "$PW_FILE" ] || die "$PW_FILE missing — is the code-server module active?"
  cat "$PW_FILE"
}

cmd_up() {
  [ $# -ge 1 ] || usage
  local name ws port cid remote_user remote_ws up_json resolved recreate="${2:-}"
  # Not inlined into the read: a die() inside a command substitution cannot
  # stop the caller, so the status has to be checked here.
  resolved=$(resolve_workspace "$1") || exit 1
  read -r name ws <<<"$resolved"
  [ -n "$name" ] || die "could not work out a name for '$1'"

  mkdir -p "$STATE/$name"
  port=$(allocate_port "$name")
  echo "$port" > "$STATE/$name/port"
  echo "$ws" > "$STATE/$name/workspace"

  # Read before anything that might consult DEFAULT_IMAGE or DOTFILES_*.
  if [ -r "$STATE/config" ]; then
    # shellcheck source=/dev/null
    . "$STATE/config"
  fi

  local -a args=(
    up
    --workspace-folder "$ws"
    --id-label "codespace=$name"
  )
  if [ "$recreate" = recreate ]; then
    args+=(--remove-existing-container)
    warn_ephemeral "$name"
  fi

  # Most repos have no devcontainer.json, and the CLI refuses to guess one.
  # --override-config is its documented answer ("required when there is no
  # devcontainer.json otherwise"). The generated config lives in the codespace's
  # state directory rather than in the repo: nothing is added to a checkout you
  # may not own, and the file is yours to edit — add features, change the image,
  # then `codespace rebuild`.
  #
  # It is only used while the repo has no config of its own. Commit a real
  # .devcontainer/devcontainer.json and it takes over on the next rebuild.
  if [ ! -f "$ws/.devcontainer/devcontainer.json" ] && [ ! -f "$ws/.devcontainer.json" ]; then
    local override="$STATE/$name/devcontainer.json"
    if [ ! -f "$override" ]; then
      note "no devcontainer.json in the repo — writing a default to $override"
      printf '{\n  "name": "%s",\n  "image": "%s"\n}\n' \
        "$name" "${DEFAULT_IMAGE:-mcr.microsoft.com/devcontainers/base:ubuntu}" > "$override"
    fi
    args+=(--override-config "$override")
  fi

  # Git credentials inside the container (CLAUDE.md §8).
  #
  # A key file under /persist/git is tried first because its path is stable.
  # Agent forwarding leaks no key at all and would otherwise be the better
  # option, but $SSH_AUTH_SOCK points at a per-session directory: a container
  # created during one SSH session holds a bind mount to a socket that is dead
  # by the next login, and git then fails in a way that looks like a key
  # problem. So it is the fallback, not the default.
  #
  # Neither mount can be read-only: the CLI validates --mount strictly as
  # type/source/target/external and rejects `readonly`. /persist/git limits the
  # exposure to one key, rather than all of ~/.ssh or the host keys.
  # Glob into an array rather than `compgen -G`: nixpkgs builds bash without
  # programmable completion, so compgen does not exist and the test silently
  # takes the wrong branch. With nullglob unset, a pattern that matches nothing
  # survives literally and fails -e.
  local git_want="" ssh_cmd="" key=/persist/git/id_ed25519
  local have_key=0 key_locked=0 have_agent=0

  [ -r "$key" ] && have_key=1
  # An encrypted key is still perfectly readable — it just cannot be *used*
  # without a passphrase, and a container has no terminal to ask at. Detect it
  # up front rather than letting ssh fail with a message that looks exactly
  # like an unregistered key.
  if [ "$have_key" = 1 ] && ! ssh-keygen -y -P "" -f "$key" >/dev/null 2>&1; then
    key_locked=1
  fi
  # `ssh-add -l` exits non-zero both when the agent is unreachable and when it
  # holds nothing, which are the same thing for our purposes.
  if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK:-}" ] && ssh-add -l >/dev/null 2>&1; then
    have_agent=1
  fi

  # GIT_SSH_MODE in /persist/codespace/config, one of:
  #
  #   auto     (default) agent if one is loaded, else an unencrypted key file
  #   agent    require the agent — fail rather than quietly exposing the key
  #   keyfile  require the key file
  #   none     no git credentials in containers at all
  #
  # `auto` is convenient but it downgrades silently: forget to `ssh-add` and it
  # mounts the private key instead, which is the opposite of what someone who
  # cares would want. `agent` makes that a hard error.
  local mode="${GIT_SSH_MODE:-auto}"
  case "$mode" in
    auto|agent|keyfile|none) ;;
    *) die "GIT_SSH_MODE must be auto, agent, keyfile or none (got '$mode')" ;;
  esac

  if [ "$mode" = agent ] || { [ "$mode" = auto ] && [ "$have_agent" = 1 ]; }; then
    if [ "$have_agent" != 1 ]; then
      die "GIT_SSH_MODE=agent, but no ssh-agent is holding a key. Run: ssh-add $key"
    fi
    # A passphrase-protected key works without anything to prompt at, and the
    # crypto happens back on the VM.
    args+=(--mount "type=bind,source=$SSH_AUTH_SOCK,target=/tmp/ssh-agent.sock")
    git_want="agent"
    ssh_cmd="ssh"
  elif [ "$mode" = keyfile ] || { [ "$mode" = auto ] && [ "$have_key" = 1 ] && [ "$key_locked" = 0 ]; }; then
    if [ "$have_key" != 1 ]; then
      die "GIT_SSH_MODE=keyfile, but there is no key at $key"
    fi
    if [ "$key_locked" = 1 ]; then
      die "GIT_SSH_MODE=keyfile, but $key has a passphrase and nothing in a container can enter it. Use GIT_SSH_MODE=agent."
    fi
    git_want="keyfile"
    ssh_cmd="ssh -i /mnt/git-ssh/id_ed25519 -o IdentitiesOnly=yes"
  elif [ "$mode" = auto ] && [ "$key_locked" = 1 ]; then
    note "warning: $key has a passphrase and no ssh-agent is holding it."
    note "         Containers cannot prompt, so git inside this one will fail"
    note "         with 'Permission denied (publickey)'. Unlock it with:"
    note "             ssh-add $key"
    note "         then: codespace rebuild $name"
  fi

  # How much of /persist/git the container can see. Only the key-file mode has
  # any use for the private key, so only that mode gets the directory. Every
  # other mode gets the public half and known_hosts as individual file mounts —
  # the container needs the .pub to configure signing (the agent does the
  # crypto) and known_hosts to verify github, and neither is secret.
  #
  # Mounting the whole directory unconditionally, as this did until now, put the
  # private key inside every container even when nothing there could use it.
  local have_known_hosts=0
  if [ "$git_want" = keyfile ]; then
    args+=(--mount "type=bind,source=/persist/git,target=/mnt/git-ssh")
    [ -r /persist/git/known_hosts ] && have_known_hosts=1
  else
    # Guarded: docker silently creates a *directory* at a bind source that does
    # not exist, which would litter /persist/git and mount the wrong thing.
    [ -r "$key.pub" ] && \
      args+=(--mount "type=bind,source=$key.pub,target=/mnt/git-ssh/id_ed25519.pub")
    # Your name and email, so a container authors commits as the same person the
    # VM does. Not secret, and the same file either way.
    [ -r /persist/git/identity ] && \
      args+=(--mount "type=bind,source=/persist/git/identity,target=/mnt/git-ssh/identity")
    if [ -r /persist/git/known_hosts ]; then
      args+=(--mount "type=bind,source=/persist/git/known_hosts,target=/mnt/git-ssh/known_hosts")
      have_known_hosts=1
    fi
  fi

  # Reference checkouts, as a sibling of the project — the same shape as real
  # Codespaces, where /workspaces itself persists. Shared across containers on
  # purpose: clone a big reference repo once and every codespace can read it.
  # CONTAINER_REFS=0 in the launcher config turns it off.
  # The name guard in resolve_workspace makes the collision unreachable for new
  # codespaces; this keeps a pre-existing one from failing on a duplicate mount.
  if [ "${CONTAINER_REFS:-1}" != 0 ] && [ -d "$REFS" ] && [ "$name" != "$REFS_NAME" ]; then
    args+=(--mount "type=bind,source=$REFS,target=/workspaces/$REFS_NAME")
  fi

  # The dotfiles clone runs *inside* the container, before anything this script
  # writes there exists — so a private dotfiles repo over https fails with
  # "could not read Username", and `up` still reports success, leaving the
  # dotfiles silently unapplied.
  #
  # --remote-env does reach that clone, so hand it the mounted key and rewrite
  # github https URLs to SSH. This makes DOTFILES_REPOSITORY work as either an
  # https or an ssh URL, private or not.
  if [ -n "$ssh_cmd" ]; then
    if [ "$have_known_hosts" = 1 ]; then
      ssh_cmd="$ssh_cmd -o UserKnownHostsFile=/mnt/git-ssh/known_hosts"
    fi
    ssh_cmd="$ssh_cmd -o StrictHostKeyChecking=accept-new"
    args+=(--remote-env "GIT_SSH_COMMAND=$ssh_cmd")
    [ "$git_want" = agent ] && args+=(--remote-env "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
    args+=(--remote-env "GIT_CONFIG_COUNT=1")
    args+=(--remote-env "GIT_CONFIG_KEY_0=url.git@github.com:.insteadOf")
    args+=(--remote-env "GIT_CONFIG_VALUE_0=https://github.com/")
  fi

  if [ -n "${DOTFILES_REPOSITORY:-}" ]; then
    args+=(--dotfiles-repository "$DOTFILES_REPOSITORY")
    [ -n "${DOTFILES_INSTALL_COMMAND:-}" ] && args+=(--dotfiles-install-command "$DOTFILES_INSTALL_COMMAND")
  fi

  note "starting dev container '$name' from $ws"
  # Progress and build logs go to stderr, so capturing stdout still shows them.
  up_json=$(devcontainer "${args[@]}") || die "devcontainer up failed"
  up_json=$(printf '%s\n' "$up_json" | tail -1)

  # Ask the CLI where things landed rather than guessing. remoteWorkspaceFolder
  # honours a workspaceFolder override in devcontainer.json, which assuming
  # /workspaces/<basename> would get wrong.
  cid=$(printf '%s' "$up_json" | jq -r '.containerId // empty')
  remote_user=$(printf '%s' "$up_json" | jq -r '.remoteUser // "root"')
  remote_ws=$(printf '%s' "$up_json" | jq -r '.remoteWorkspaceFolder // empty')
  [ -n "$cid" ] || die "devcontainer up reported no container: $up_json"
  [ -n "$remote_ws" ] || die "devcontainer up reported no workspace folder: $up_json"

  # Recorded so `codespace shell` can open a shell as the right user in the
  # right directory without paying for another `devcontainer up`.
  echo "$remote_user" > "$STATE/$name/remote_user"
  echo "$remote_ws" > "$STATE/$name/remote_workspace"

  # What the container actually has, not what the host happened to offer. `up`
  # reuses an existing container and silently ignores changed --mount flags, so
  # trusting git_want here would configure the editor for a mount that is not
  # there.
  local mounts git_ssh=""
  mounts=$(docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$cid")
  case " $mounts " in
    *" /tmp/ssh-agent.sock "*) git_ssh="agent" ;;
    # The whole directory, so the private key is there and usable.
    *" /mnt/git-ssh "*)        git_ssh="keyfile" ;;
    # Only the public half — no way to authenticate from in here.
    *" /mnt/git-ssh/id_ed25519.pub "*) git_ssh="locked" ;;
  esac
  if [ -n "$git_want" ] && [ "$git_want" != "$git_ssh" ] && [ "$git_ssh" != locked ]; then
    note "note: this container was created with git credentials '$git_ssh:-none';"
    note "      '$git_want' is available now — 'codespace rebuild $name' to switch"
  fi

  # Installed after every `up`, not baked in as a feature: no third-party
  # feature for code-server resolves on ghcr, and doing it here leaves the
  # project's devcontainer.json untouched so it stays portable to real
  # Codespaces. `--method standalone` avoids apt, so this works on any glibc
  # base image. Recreating the container discards it, hence the check.
  note "ensuring code-server is installed"
  docker exec -u "$remote_user" "$cid" bash -lc \
    'command -v code-server >/dev/null || curl -fsSL https://code-server.dev/install.sh | sudo sh -s -- --method standalone --prefix /usr/local' \
    || die "could not install code-server in the container"

  # Real Codespaces injects GITHUB_TOKEN so `gh` works inside the container
  # without a second login. Nothing does that here, so hand the container the
  # VM's own gh token. Read at `up` time — after `gh auth login` or a token
  # change, `codespace up` again to refresh it. Set CONTAINER_GH_TOKEN=0 in
  # /persist/codespace/config to keep the token on the VM instead.
  local gh_token=""
  if [ "${CONTAINER_GH_TOKEN:-1}" != 0 ]; then
    gh_token=$(gh auth token 2>/dev/null || true)
  fi

  local remote_home
  remote_home=$(docker exec -u "$remote_user" "$cid" sh -c 'echo $HOME' 2>/dev/null | tr -d '\r')
  [ -n "$remote_home" ] || remote_home="/home/$remote_user"

  # The token goes in a 0600 file of its own rather than into /etc/profile.d,
  # which has to stay world-readable for login shells to source it.
  local tokenfile="$remote_home/.codespace-token"
  if [ -n "$gh_token" ]; then
    local tmptok
    tmptok=$(mktemp)
    printf 'export GH_TOKEN=%s\n' "$gh_token" > "$tmptok"
    docker cp "$tmptok" "$cid:$tokenfile" >/dev/null
    docker exec -u root "$cid" chown "$remote_user" "$tokenfile"
    docker exec -u root "$cid" chmod 0600 "$tokenfile"
    rm -f "$tmptok"
  else
    # Do not leave a token behind from a previous up.
    docker exec -u root "$cid" rm -f "$tokenfile" 2>/dev/null || true
  fi

  # Wire the identity in at the container's *system* level, so `git commit`
  # knows who you are whether or not you use a dotfiles repo. Mounting the file
  # is not enough on its own — something has to include it, and until now only
  # the dotfiles did, so a codespace without them committed with no author.
  #
  # `git config --system` rather than a literal /etc/gitconfig: the devcontainer
  # git feature builds git from source, and the system config path follows its
  # prefix. --replace-all keeps repeated `up` runs idempotent.
  if docker exec "$cid" test -r /mnt/git-ssh/identity 2>/dev/null; then
    docker exec -u root "$cid" \
      git config --system --replace-all include.path /mnt/git-ssh/identity 2>/dev/null \
      || note "note: could not set the git identity include (is git in the image?)"
  fi

  [ -n "${APT_MIRROR:-}" ] && apply_apt_mirror "$cid" "$APT_MIRROR"

  # Login shells get the git env too; the editor's own terminals inherit it
  # from the code-server process below.
  local envfile
  envfile=$(mktemp)
  {
    echo "export CODESPACE_NAME=$name"
    case "$git_ssh" in
      agent)
        echo 'export SSH_AUTH_SOCK=/tmp/ssh-agent.sock'
        echo "export GIT_SSH_COMMAND=\"$ssh_cmd\""
        ;;
      keyfile)
        echo "export GIT_SSH_COMMAND=\"$ssh_cmd\""
        ;;
    esac
    # Deliberately unexpanded: $HOME has to resolve inside the container at
    # login, not out here.
    # shellcheck disable=SC2016
    echo '[ -r "$HOME/.codespace-token" ] && . "$HOME/.codespace-token"'
  } > "$envfile"
  docker cp "$envfile" "$cid:/etc/profile.d/codespace.sh" >/dev/null
  docker exec -u root "$cid" chmod 0644 /etc/profile.d/codespace.sh
  rm -f "$envfile"

  # code-server has to be told which folder to open. Without it the editor comes
  # up with no workspace at all: the code is mounted and the container is fine,
  # but the file tree is empty and terminals start in $HOME.
  #
  # The arguments are recorded next to the log so that an editor started by an
  # older version of this script — or with a different folder — is replaced
  # rather than left running.
  #
  # '[c]ode-server' rather than 'code-server': the pattern is being matched
  # against full command lines, and the sh running pgrep has the pattern in its
  # own, so an unbracketed pattern always matches itself.
  local want="0.0.0.0:$EDITOR_PORT $remote_ws"
  if ! docker exec "$cid" sh -c \
       "[ \"\$(cat /tmp/code-server.args 2>/dev/null)\" = \"$want\" ] \
        && pgrep -f '[c]ode-server.*--bind-addr' >/dev/null" 2>/dev/null
  then
    note "starting editor on $remote_ws"
    docker exec -u root "$cid" sh -c "pkill -f '[c]ode-server.*--bind-addr' >/dev/null 2>&1; exit 0"
    local -a envargs=(-e "PASSWORD=$(editor_password)")
    [ -n "$gh_token" ] && envargs+=(-e "GH_TOKEN=$gh_token")
    case "$git_ssh" in
      agent)   envargs+=(-e SSH_AUTH_SOCK=/tmp/ssh-agent.sock -e "GIT_SSH_COMMAND=$ssh_cmd") ;;
      keyfile) envargs+=(-e "GIT_SSH_COMMAND=$ssh_cmd") ;;
    esac
    docker exec -d -u "$remote_user" "${envargs[@]}" "$cid" bash -lc \
      "printf '%s' \"$want\" > /tmp/code-server.args
       exec code-server --bind-addr 0.0.0.0:$EDITOR_PORT --auth password \
         --disable-telemetry --disable-update-check \
         \"$remote_ws\" >/tmp/code-server.log 2>&1"
  fi

  # The CLI has no way to publish a port on a container it creates, so the
  # editor is reached through a proxy on the VM. See modules/codespace.nix.
  #
  # reset-failed first: a unit that hit its start limit refuses `restart`
  # outright, and the failure is otherwise indistinguishable from a broken
  # editor. And check the result — ignoring it is what made this look like the
  # editor's fault.
  sudo systemctl reset-failed "codespace-proxy@$name.service" 2>/dev/null || true
  if ! sudo systemctl restart "codespace-proxy@$name.service"; then
    die "could not start the editor proxy. See: systemctl status codespace-proxy@$name"
  fi

  note "waiting for the editor"
  local i
  for i in $(seq 1 30); do
    if curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$port/login" 2>/dev/null; then break; fi
    if [ "$i" = 30 ]; then
      # "Nothing on the port" has two completely different causes with
      # completely different fixes, so say which one it is rather than making
      # the reader guess.
      local cip
      cip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$cid" 2>/dev/null)
      if [ -n "$cip" ] && curl -fsS -o /dev/null --max-time 3 "http://$cip:$EDITOR_PORT/login" 2>/dev/null; then
        note "the editor is up inside the container at $cip:$EDITOR_PORT,"
        note "but nothing answers on http://127.0.0.1:$port/ — so the proxy is at fault:"
        note "    systemctl status codespace-proxy@$name"
        note "    journalctl -u codespace-proxy@$name -n 20"
      else
        note "the editor is not answering inside the container either:"
        note "    codespace logs $name"
      fi
      die "editor did not answer on port $port"
    fi
    sleep 1
  done

  echo
  echo "  $name is up"
  echo "  http://localhost:$port/"
  echo "  password: $(editor_password)"
  [ "$git_ssh" = agent ] && echo "  git: ssh agent forwarded (key stays on the VM)"
  [ "$git_ssh" = keyfile ] && echo "  git: key from /persist/git"
  [ "$git_ssh" = locked ] && echo "  git: UNAVAILABLE — key is passphrase-locked, run 'ssh-add $key'"
  [ -n "$gh_token" ] && echo "  gh:  authenticated with the VM's token"
  [ -z "$git_ssh" ] && echo "  git: no credentials mounted (see 'Git inside containers' in the README)"
  echo
  echo "  F1 opens the command palette. Ctrl+Shift+P is a Firefox private window."
}

cmd_down() {
  [ $# -ge 1 ] || usage
  local name cid
  name=$(slugify "$1")
  sudo systemctl stop "codespace-proxy@$name.service" 2>/dev/null || true
  cid=$(container_of "$name")
  if [ -n "$cid" ]; then
    note "stopping $name"
    docker stop "$cid" >/dev/null
  else
    note "$name is not running"
  fi
}

cmd_new() {
  [ $# -ge 1 ] || usage
  local name
  name=$(slugify "$1")
  [ -n "$name" ] || die "give the codespace a name"
  # Before mkdir, so a refused name leaves nothing behind.
  reject_reserved "$name"

  if [ -e "$REPOS/$name" ] && [ ! -d "$REPOS/$name" ]; then
    die "$REPOS/$name exists and is not a directory"
  fi

  if [ -d "$REPOS/$name" ]; then
    note "$REPOS/$name already exists — starting it"
  else
    note "creating an empty workspace at $REPOS/$name"
    mkdir -p "$REPOS/$name"
  fi

  # Deliberately not `git init`: an empty directory is the whole point, and
  # guessing that you want a repo here would be presumptuous.
  cmd_up "$name"
}

# A terminal inside a codespace, from the VM — so you can work from Windows
# Terminal instead of the browser. Not sshd in the container: that would mean a
# daemon and authorised keys in every image, plus another forwarded port per
# codespace, to reach something `docker exec` already reaches through the SSH
# session you are sitting in.
# Point the container's apt at a nearer Ubuntu mirror. Opt-in via APT_MIRROR in
# the launcher config, because the right mirror depends entirely on where you
# are.
#
# This runs after the image is built, so it speeds up apt *inside* the container
# — your own installs, postCreateCommand, anything later. It cannot speed up
# devcontainer features, which apt-install during the build, before any of this
# exists.
apply_apt_mirror() {
  local cid="$1" mirror="${2%/}/"

  # Nothing to do if the sources already point somewhere else — which also makes
  # a repeat `up` free rather than re-running apt-get update every time.
  docker exec "$cid" sh -c \
    'grep -rqE "https?://([a-z0-9.-]+\.)?(archive|security)\.ubuntu\.com" /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null' \
    2>/dev/null || return 0

  note "pointing apt at $mirror"
  # Both layouts: deb822 .sources (Ubuntu 24.04 onward) and legacy .list files.
  # Regional mirrors like azure.archive.ubuntu.com are matched too.
  docker exec -u root "$cid" sh -c '
    mirror="$1"
    files=$(ls /etc/apt/sources.list /etc/apt/sources.list.d/*.sources                /etc/apt/sources.list.d/*.list 2>/dev/null) || true
    [ -n "$files" ] || exit 0
    sed -i -E "s#https?://([a-z0-9.-]+\.)?(archive|security)\.ubuntu\.com/ubuntu/?#${mirror}#g" $files
  ' _ "$mirror" 2>/dev/null || { note "note: could not rewrite apt sources"; return 0; }

  # apt caches package lists per URL, so they are stale the moment the URL
  # changes; without this the next `apt install` just fails.
  docker exec -u root "$cid" sh -c 'apt-get update -qq' >/dev/null 2>&1 \
    || note "note: apt-get update against $mirror failed — run it yourself to see why"
}

# Only /workspaces/<the repo> is a mount. Anything else under /workspaces, and
# anything in $HOME, lives in the container's writable layer and dies with it.
# Say so before throwing the container away, rather than after.
warn_ephemeral() {
  local name="$1" cid kept entry found=0
  cid=$(container_of "$name") || true
  [ -n "$cid" ] || return 0

  # Every bind mount under /workspaces is backed by something on /persist — the
  # project itself and, when enabled, refs. Ask docker rather than assuming, so
  # adding a mount later cannot turn into a false alarm.
  kept=$(docker inspect "$cid" \
    | jq -r '.[0].Mounts[] | select(.Destination | startswith("/workspaces/")) | .Destination' \
    2>/dev/null | xargs -r -n1 basename || true)

  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    printf '%s\n' "$kept" | grep -qxF "$entry" && continue
    if [ "$found" = 0 ]; then
      note "warning: these are not on /persist and will be lost:"
      found=1
    fi
    note "             /workspaces/$entry"
  done < <(docker exec "$cid" sh -c 'ls -1 /workspaces 2>/dev/null' 2>/dev/null || true)

  [ "$found" = 1 ] && note "         only the mounted directories are on /persist"
  return 0
}

cmd_shell() {
  [ $# -ge 1 ] || usage
  local name cid ruser rws use_tmux=1
  name=$(slugify "$1"); shift

  while [ $# -gt 0 ]; do
    case "$1" in
      --no-tmux) use_tmux=0; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  cid=$(container_of "$name")
  [ -n "$cid" ] || die "$name is not running — 'codespace up $name' first"

  # From state where `up` left it; otherwise dug back out of the container, so
  # this still works for one created before that was recorded.
  ruser=$(cat "$STATE/$name/remote_user" 2>/dev/null || true)
  if [ -z "$ruser" ]; then
    ruser=$(docker inspect "$cid" \
      | jq -r '[.[0].Config.Labels."devcontainer.metadata" // "[]" | fromjson | .[]?.remoteUser // empty] | last // empty' \
      2>/dev/null || true)
  fi
  [ -n "$ruser" ] || ruser=root

  rws=$(cat "$STATE/$name/remote_workspace" 2>/dev/null || true)
  if [ -z "$rws" ]; then
    rws=$(docker inspect "$cid" \
      | jq -r '.[0].Mounts[] | select(.Destination | startswith("/workspaces")) | .Destination' \
      2>/dev/null | head -1 || true)
  fi
  [ -n "$rws" ] || rws=/

  # -t only when there is a terminal to allocate, so `codespace shell x -- cmd`
  # stays usable in a pipe or a script.
  local -a dexec=(docker exec -i)
  [ -t 0 ] && dexec+=(-t)
  dexec+=(-u "$ruser" -w "$rws" "$cid")

  # A one-shot command never wants a persistent session wrapped around it.
  if [ $# -gt 0 ]; then
    exec "${dexec[@]}" bash -lc "$*"
  fi

  # tmux lives on the VM, not in the container: it survives your SSH dropping,
  # and it does not require every image to ship tmux. attach-or-create, so
  # reconnecting puts you back in the same shell rather than a fresh one.
  if [ "$use_tmux" = 1 ] && [ -z "${TMUX:-}" ] && [ -t 0 ]; then
    local session cmd
    session="cs-$(echo "$name" | tr '.:' '--')"
    cmd=$(printf '%q ' "${dexec[@]}" bash -l)
    exec tmux new-session -A -s "$session" "$cmd"
  fi

  exec "${dexec[@]}" bash -l
}

cmd_rm() {
  [ $# -ge 1 ] || usage
  local name cid keep_repo=1
  name=$(slugify "$1")
  [ "${2:-}" = "--repo" ] && keep_repo=0

  warn_ephemeral "$name"
  sudo systemctl stop "codespace-proxy@$name.service" 2>/dev/null || true

  cid=$(container_any "$name")
  if [ -n "$cid" ]; then
    note "removing container for $name"
    docker rm -f "$cid" >/dev/null
  fi

  # Drops the port reservation and any generated devcontainer.json, so the next
  # `up` starts clean. The checkout is left alone unless asked: it is the one
  # thing here that might hold work that is not pushed yet.
  rm -rf "${STATE:?}/$name"

  if [ "$keep_repo" = 0 ]; then
    note "removing $REPOS/$name"
    rm -rf "${REPOS:?}/$name"
  elif [ -d "$REPOS/$name" ]; then
    echo "  the checkout is still at $REPOS/$name"
    echo "  'codespace rm $name --repo' deletes that too"
  fi
}

cmd_list() {
  local dir name port cid status
  printf '%-24s %-6s %-10s %s\n' NAME PORT STATE URL
  for dir in "$STATE"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    [ -f "$dir/port" ] || continue
    port=$(cat "$dir/port")
    cid=$(container_of "$name")
    if [ -n "$cid" ]; then status=running
    elif [ -n "$(container_any "$name")" ]; then status=stopped
    else status=absent; fi
    printf '%-24s %-6s %-10s %s\n' "$name" "$port" "$status" "http://localhost:$port/"
  done
}

cmd_logs() {
  [ $# -ge 1 ] || usage
  local name cid
  name=$(slugify "$1")
  cid=$(container_of "$name") || true
  [ -n "$cid" ] || die "$name is not running"
  docker exec "$cid" cat /tmp/code-server.log
}

[ $# -ge 1 ] || usage 0
sub="$1"; shift
case "$sub" in
  up)    cmd_up "$@" ;;
  new|blank) cmd_new "$@" ;;
  rebuild)
         [ $# -ge 1 ] || usage
         cmd_up "$1" recreate ;;
  down)  cmd_down "$@" ;;
  shell|sh) cmd_shell "$@" ;;
  rm|delete) cmd_rm "$@" ;;
  list|ls) cmd_list "$@" ;;
  logs)  cmd_logs "$@" ;;
  -h|--help|help) usage 0 ;;
  *)     die "unknown command '$sub' (try: up, new, shell, rebuild, down, rm, list, logs)" ;;
esac
